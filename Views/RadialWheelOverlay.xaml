<Window x:Class="AmpUp.Views.RadialWheelOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="460" Height="460"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Storyboard x:Key="FadeIn">
            <DoubleAnimation Storyboard.TargetName="RootGrid"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.2">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
        <Storyboard x:Key="FadeOut">
            <DoubleAnimation Storyboard.TargetName="RootGrid"
                             Storyboard.TargetProperty="Opacity"
                             From="1" To="0" Duration="0:0:0.2">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseIn" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Window.Resources>

    <!-- Halo layout: glass backdrop, ring of segments (code-behind), center card -->
    <Grid x:Name="RootGrid" Opacity="0" KeyDown="Window_KeyDown" Focusable="True">

        <!-- Glass backdrop -->
        <Ellipse Width="404" Height="404"
                 HorizontalAlignment="Center" VerticalAlignment="Center"
                 Stroke="#0DFFFFFF" StrokeThickness="1">
            <Ellipse.Fill>
                <SolidColorBrush Color="#D6101010" />
            </Ellipse.Fill>
            <Ellipse.Effect>
                <DropShadowEffect x:Name="OuterGlow" BlurRadius="36" Opacity="0.22" ShadowDepth="0" />
            </Ellipse.Effect>
        </Ellipse>

        <!-- Ring segments + icons — drawn in code-behind -->
        <Canvas x:Name="SegmentCanvas"
                Width="420" Height="420"
                HorizontalAlignment="Center" VerticalAlignment="Center" />

        <!-- Center card -->
        <Ellipse x:Name="CenterDisc" Width="252" Height="252"
                 HorizontalAlignment="Center" VerticalAlignment="Center"
                 StrokeThickness="1">
            <Ellipse.Fill>
                <SolidColorBrush Color="#EB0C0C0C" />
            </Ellipse.Fill>
        </Ellipse>

        <StackPanel x:Name="CenterPanel"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Width="200" IsHitTestVisible="False" />

    </Grid>
</Window>
