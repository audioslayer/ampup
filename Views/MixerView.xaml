<UserControl x:Class="AmpUp.Views.MixerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:AmpUp.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  Background="Transparent">
        <StackPanel Margin="0,0,0,24">
            <ContentControl x:Name="MixerPageHeaderHost" Focusable="False" />
            <Border x:Name="MixerSurfaceBar" Style="{StaticResource CardPanel}" Margin="0,0,0,10" Visibility="Collapsed">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Border Width="3" CornerRadius="2" Background="{DynamicResource AccentBrush}" Margin="0,0,10,0" />
                        <TextBlock Text="MIXER SURFACE" Style="{StaticResource HeaderText}" Margin="0" />
                    </StackPanel>
                    <controls:SegmentedControl x:Name="MixerDeviceSelector"
                                               HorizontalAlignment="Left"
                                               MinWidth="360" />
                </StackPanel>
            </Border>

            <StackPanel x:Name="TurnUpMixerContent">

            <!-- ── CHANNEL STRIPS + SETTINGS GRID ─────────────────── -->
            <!-- Row 0: knob cards (target + optional volume range inside) share one row so all
                 five cards have the same height and line up. Row 1: curve cards. -->
            <Grid x:Name="ChannelGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border x:Name="Ch0Border" Grid.Row="0" Grid.Column="0" Style="{StaticResource CardPanel}" Padding="0" ClipToBounds="True" Margin="0,0,4,10">
                    <Grid><controls:ChannelGlowControl x:Name="Ch0Glow" />
                        <StackPanel Margin="10,12">
                            <StackPanel x:Name="Ch0Panel" />
                            <Border x:Name="Ch0Range" Visibility="Collapsed" Margin="0,0,0,8" />
                            <Border x:Name="Ch0Target" Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Border x:Name="Ch0Curve" Grid.Row="1" Grid.Column="0" Margin="0,0,4,0" />
                <Border x:Name="Ch1Border" Grid.Row="0" Grid.Column="1" Style="{StaticResource CardPanel}" Padding="0" ClipToBounds="True" Margin="4,0,4,10">
                    <Grid><controls:ChannelGlowControl x:Name="Ch1Glow" />
                        <StackPanel Margin="10,12">
                            <StackPanel x:Name="Ch1Panel" />
                            <Border x:Name="Ch1Range" Visibility="Collapsed" Margin="0,0,0,8" />
                            <Border x:Name="Ch1Target" Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Border x:Name="Ch1Curve" Grid.Row="1" Grid.Column="1" Margin="4,0" />
                <Border x:Name="Ch2Border" Grid.Row="0" Grid.Column="2" Style="{StaticResource CardPanel}" Padding="0" ClipToBounds="True" Margin="4,0,4,10">
                    <Grid><controls:ChannelGlowControl x:Name="Ch2Glow" />
                        <StackPanel Margin="10,12">
                            <StackPanel x:Name="Ch2Panel" />
                            <Border x:Name="Ch2Range" Visibility="Collapsed" Margin="0,0,0,8" />
                            <Border x:Name="Ch2Target" Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Border x:Name="Ch2Curve" Grid.Row="1" Grid.Column="2" Margin="4,0" />
                <Border x:Name="Ch3Border" Grid.Row="0" Grid.Column="3" Style="{StaticResource CardPanel}" Padding="0" ClipToBounds="True" Margin="4,0,4,10">
                    <Grid><controls:ChannelGlowControl x:Name="Ch3Glow" />
                        <StackPanel Margin="10,12">
                            <StackPanel x:Name="Ch3Panel" />
                            <Border x:Name="Ch3Range" Visibility="Collapsed" Margin="0,0,0,8" />
                            <Border x:Name="Ch3Target" Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Border x:Name="Ch3Curve" Grid.Row="1" Grid.Column="3" Margin="4,0" />
                <Border x:Name="Ch4Border" Grid.Row="0" Grid.Column="4" Style="{StaticResource CardPanel}" Padding="0" ClipToBounds="True" Margin="4,0,0,10">
                    <Grid><controls:ChannelGlowControl x:Name="Ch4Glow" />
                        <StackPanel Margin="10,12">
                            <StackPanel x:Name="Ch4Panel" />
                            <Border x:Name="Ch4Range" Visibility="Collapsed" Margin="0,0,0,8" />
                            <Border x:Name="Ch4Target" Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Border x:Name="Ch4Curve" Grid.Row="1" Grid.Column="4" Margin="4,0,0,0" />
            </Grid>
            </StackPanel>

            <Border x:Name="StreamControllerMixerPanel" Style="{StaticResource CardPanel}" Margin="0,10,0,0" Visibility="Collapsed">
                <StackPanel x:Name="StreamControllerMixerContent" />
            </Border>

            <!-- ── SMART MIX (built in MixerView.SmartMix.cs) ─────────── -->
            <StackPanel x:Name="SmartMixContent" Margin="0,24,0,0" />

            <!-- ── AUDIO SESSIONS (built in MixerView.Sessions.cs) ────── -->
            <StackPanel x:Name="AudioSessionsContent" Margin="0,12,0,0" />

        </StackPanel>
    </ScrollViewer>
</UserControl>
