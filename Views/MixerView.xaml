<UserControl x:Class="AmpUp.Views.MixerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:AmpUp.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  Background="Transparent">
        <StackPanel Margin="0,0,0,24">
            <ContentControl x:Name="MixerPageHeaderHost" Focusable="False" />
            <Border x:Name="MixerSurfaceBar" Style="{StaticResource CardPanel}" Margin="0,0,0,10" Visibility="Collapsed">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Border Width="3" CornerRadius="2" Background="{DynamicResource AccentBrush}" Margin="0,0,10,0" />
                        <TextBlock Text="MIXER SURFACE" Style="{StaticResource HeaderText}" Margin="0" />
                    </StackPanel>
                    <controls:SegmentedControl x:Name="MixerDeviceSelector"
                                               HorizontalAlignment="Left"
                                               MinWidth="360" />
                </StackPanel>
            </Border>

            <StackPanel x:Name="TurnUpMixerContent">

            <!-- ── CHANNEL STRIPS + SETTINGS GRID ─────────────────── -->
            <!-- One independent column per knob: the target picker lives inside the knob card,
                 so a tall app group on one knob no longer stretches every other column. -->
            <Grid x:Name="ChannelGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,4,0">
                    <Border x:Name="Ch0Border" Style="{StaticResource CardPanel}" Padding="0" ClipToBounds="True" Margin="0,0,0,10">
                        <Grid><controls:ChannelGlowControl x:Name="Ch0Glow" />
                            <StackPanel Margin="10,12">
                                <StackPanel x:Name="Ch0Panel" />
                                <Border x:Name="Ch0Target" Margin="0,8,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border x:Name="Ch0Range" />
                    <Border x:Name="Ch0Curve" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="4,0">
                    <Border x:Name="Ch1Border" Style="{StaticResource CardPanel}" Padding="0" ClipToBounds="True" Margin="0,0,0,10">
                        <Grid><controls:ChannelGlowControl x:Name="Ch1Glow" />
                            <StackPanel Margin="10,12">
                                <StackPanel x:Name="Ch1Panel" />
                                <Border x:Name="Ch1Target" Margin="0,8,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border x:Name="Ch1Range" />
                    <Border x:Name="Ch1Curve" />
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="4,0">
                    <Border x:Name="Ch2Border" Style="{StaticResource CardPanel}" Padding="0" ClipToBounds="True" Margin="0,0,0,10">
                        <Grid><controls:ChannelGlowControl x:Name="Ch2Glow" />
                            <StackPanel Margin="10,12">
                                <StackPanel x:Name="Ch2Panel" />
                                <Border x:Name="Ch2Target" Margin="0,8,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border x:Name="Ch2Range" />
                    <Border x:Name="Ch2Curve" />
                </StackPanel>
                <StackPanel Grid.Column="3" Margin="4,0">
                    <Border x:Name="Ch3Border" Style="{StaticResource CardPanel}" Padding="0" ClipToBounds="True" Margin="0,0,0,10">
                        <Grid><controls:ChannelGlowControl x:Name="Ch3Glow" />
                            <StackPanel Margin="10,12">
                                <StackPanel x:Name="Ch3Panel" />
                                <Border x:Name="Ch3Target" Margin="0,8,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border x:Name="Ch3Range" />
                    <Border x:Name="Ch3Curve" />
                </StackPanel>
                <StackPanel Grid.Column="4" Margin="4,0,0,0">
                    <Border x:Name="Ch4Border" Style="{StaticResource CardPanel}" Padding="0" ClipToBounds="True" Margin="0,0,0,10">
                        <Grid><controls:ChannelGlowControl x:Name="Ch4Glow" />
                            <StackPanel Margin="10,12">
                                <StackPanel x:Name="Ch4Panel" />
                                <Border x:Name="Ch4Target" Margin="0,8,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border x:Name="Ch4Range" />
                    <Border x:Name="Ch4Curve" />
                </StackPanel>
            </Grid>
            </StackPanel>

            <Border x:Name="StreamControllerMixerPanel" Style="{StaticResource CardPanel}" Margin="0,10,0,0" Visibility="Collapsed">
                <StackPanel x:Name="StreamControllerMixerContent" />
            </Border>

            <!-- ── SMART MIX (built in MixerView.SmartMix.cs) ─────────── -->
            <StackPanel x:Name="SmartMixContent" Margin="0,24,0,0" />

            <!-- ── AUDIO SESSIONS (built in MixerView.Sessions.cs) ────── -->
            <StackPanel x:Name="AudioSessionsContent" Margin="0,12,0,0" />

        </StackPanel>
    </ScrollViewer>
</UserControl>
