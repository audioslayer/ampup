                                    <mi:MaterialIcon x:Name="ModeCheckStreamController" Kind="CheckCircle" Style="{StaticResource HwModeCheck}" />
                                </Grid>
                            </Border>
                            <Border x:Name="ModeCardBoth" Tag="3" Style="{StaticResource HwModeCard}" MouseLeftButtonUp="ModeCard_Click">
