                                            <ui:TextBox x:Name="TxtSerialPort" Style="{StaticResource SInput}" MaxWidth="220" HorizontalAlignment="Left" Width="220"
                                                        PlaceholderText="COM3" Margin="0,0,0,12"
                                                        ToolTip="COM port for the AmpUp hardware (e.g. COM3)" />
                                            <TextBlock Text="Baud rate" Style="{StaticResource SField}"
                                                       ToolTip="Communication speed — leave at 115200" />
                                            <ui:TextBox x:Name="TxtBaudRate" Style="{StaticResource SInput}" MaxWidth="220" HorizontalAlignment="Left" Width="220"
                                                        PlaceholderText="115200"
                                                        ToolTip="Communication speed — leave at 115200" />
                                        </StackPanel>
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <!-- Stream Controller (TreasLin N3) -->
                            <Border x:Name="DevCardStreamController" Style="{StaticResource HwDeviceCard}">
                                <DockPanel LastChildFill="True">
                                    <Border DockPanel.Dock="Top" Style="{StaticResource HwDeviceStage}">
                                        <Grid>
                                            <Viewbox x:Name="ArtStreamController" Stretch="Uniform" Margin="18">
                                                <Canvas Width="300" Height="170">
                                                    <Rectangle Width="300" Height="170" RadiusX="22" RadiusY="22" Stroke="#33FFFFFF" StrokeThickness="1.5">
                                                        <Rectangle.Fill>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                <GradientStop Color="#FF2A2D33" Offset="0" />
                                                                <GradientStop Color="#FF15171B" Offset="1" />
                                                            </LinearGradientBrush>
                                                        </Rectangle.Fill>
                                                    </Rectangle>
                                                    <!-- 2x3 LCD keys -->
                                                    <Rectangle Canvas.Left="20" Canvas.Top="18" Width="54" Height="54" RadiusX="9" RadiusY="9" Fill="{DynamicResource AccentBg30Brush}" Stroke="{DynamicResource AccentBorder55Brush}" StrokeThickness="1.5" />
                                                    <Rectangle Canvas.Left="84" Canvas.Top="18" Width="54" Height="54" RadiusX="9" RadiusY="9" Fill="#FF1B2B3A" Stroke="#40FFFFFF" StrokeThickness="1" />
                                                    <Rectangle Canvas.Left="148" Canvas.Top="18" Width="54" Height="54" RadiusX="9" RadiusY="9" Fill="#FF2E1F3A" Stroke="#40FFFFFF" StrokeThickness="1" />
                                                    <Rectangle Canvas.Left="20" Canvas.Top="82" Width="54" Height="54" RadiusX="9" RadiusY="9" Fill="#FF3A2A1B" Stroke="#40FFFFFF" StrokeThickness="1" />
                                                    <Rectangle Canvas.Left="84" Canvas.Top="82" Width="54" Height="54" RadiusX="9" RadiusY="9" Fill="{DynamicResource AccentBg30Brush}" Stroke="{DynamicResource AccentBorder55Brush}" StrokeThickness="1.5" />
                                                    <Rectangle Canvas.Left="148" Canvas.Top="82" Width="54" Height="54" RadiusX="9" RadiusY="9" Fill="#FF1B3A2E" Stroke="#40FFFFFF" StrokeThickness="1" />
                                                    <!-- 3 side buttons -->
                                                    <Rectangle Canvas.Left="20" Canvas.Top="146" Width="54" Height="10" RadiusX="5" RadiusY="5" Fill="#FF2C3036" />
                                                    <Rectangle Canvas.Left="84" Canvas.Top="146" Width="54" Height="10" RadiusX="5" RadiusY="5" Fill="#FF2C3036" />
                                                    <Rectangle Canvas.Left="148" Canvas.Top="146" Width="54" Height="10" RadiusX="5" RadiusY="5" Fill="#FF2C3036" />
                                                    <!-- 3 knobs -->
                                                    <Ellipse Canvas.Left="228" Canvas.Top="16" Width="44" Height="44" Fill="#FF0E0F12" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2" Opacity="0.9" />
                                                    <Rectangle Canvas.Left="249" Canvas.Top="21" Width="2" Height="10" RadiusX="1" RadiusY="1" Fill="#DDFFFFFF" />
                                                    <Ellipse Canvas.Left="228" Canvas.Top="66" Width="44" Height="44" Fill="#FF0E0F12" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2" Opacity="0.9" />
                                                    <Rectangle Canvas.Left="249" Canvas.Top="71" Width="2" Height="10" RadiusX="1" RadiusY="1" Fill="#DDFFFFFF" />
                                                    <Ellipse Canvas.Left="228" Canvas.Top="116" Width="44" Height="44" Fill="#FF0E0F12" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2" Opacity="0.9" />
                                                    <Rectangle Canvas.Left="249" Canvas.Top="121" Width="2" Height="10" RadiusX="1" RadiusY="1" Fill="#DDFFFFFF" />
                                                </Canvas>
                                            </Viewbox>
                                            <Image x:Name="ImgStreamController" Visibility="Collapsed" Stretch="Uniform" Margin="14"
                                                   RenderOptions.BitmapScalingMode="HighQuality" />
                                        </Grid>
                                    </Border>
                                    <Border x:Name="DrivesPillStreamController" DockPanel.Dock="Bottom" Margin="18,0,18,18" Style="{StaticResource HwDrivesPill}" MouseLeftButtonUp="DrivesPill_Click"
                                                ToolTip="Show this device's controls in the Mixer, Buttons and Lights tabs">
                                            <StackPanel Orientation="Horizontal">
                                                <mi:MaterialIcon x:Name="DrivesIconStreamController" Kind="CheckCircle" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                <TextBlock x:Name="DrivesTextStreamController" Text="Show in Mixer, Buttons &amp; Lights" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                <StackPanel Margin="18,14,18,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Stream Controller" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                <TextBlock Text="TreasLin N3 · 6 LCD keys · 3 knobs" Style="{StaticResource SSub}" />
                                            </StackPanel>
                                            <Border Grid.Column="1" Style="{StaticResource SPill}" Margin="8,0,0,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse x:Name="N3ConnectionDot" Style="{StaticResource SDot}" Fill="{DynamicResource DangerRedBrush}" />
                                                    <TextBlock x:Name="TxtN3ConnectionStatus" Text="Not detected" Style="{StaticResource SStatusText}" />
