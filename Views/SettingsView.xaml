                                        <Border Style="{StaticResource SDivider}" Margin="0,6,0,10" />
                                        <StackPanel Orientation="Horizontal" Cursor="Hand" Background="Transparent"
                                                    x:Name="AdvancedToggle" MouseLeftButtonDown="AdvancedToggle_Click">
                                            <mi:MaterialIcon x:Name="AdvancedArrow" Kind="ChevronRight" Width="16" Height="16"
                                                             Foreground="{DynamicResource TextDimBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                            <TextBlock Text="Connection settings" FontSize="12" Foreground="{DynamicResource TextSecBrush}" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <StackPanel x:Name="AdvancedSection" Visibility="Collapsed" Margin="22,12,0,0">
