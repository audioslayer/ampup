                                        <Ellipse x:Name="HeroStatusDot" Style="{StaticResource SDot}" Width="9" Height="9" Fill="{DynamicResource DangerRedBrush}" />
                                        <TextBlock x:Name="TxtHeroStatus" Text="No devices connected" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Hardware mode chooser -->
                        <StackPanel Orientation="Horizontal" Margin="2,20,0,10">
