                                    <Border DockPanel.Dock="Top" Style="{StaticResource HwDeviceStage}">
                                        <Grid>
                                            <Viewbox x:Name="ArtTurnUp" Stretch="Uniform" Margin="18">
                                                <Canvas Width="360" Height="150">
                                                    <Rectangle Width="360" Height="150" RadiusX="22" RadiusY="22" Stroke="#33FFFFFF" StrokeThickness="1.5">
                                                        <Rectangle.Fill>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                <GradientStop Color="#FF2A2D33" Offset="0" />
                                                                <GradientStop Color="#FF15171B" Offset="1" />
                                                            </LinearGradientBrush>
                                                        </Rectangle.Fill>
                                                    </Rectangle>
                                                    <!-- 5 knobs: accent LED ring + dark cap + pointer -->
                                                    <Ellipse Canvas.Left="20" Canvas.Top="18" Width="56" Height="56" Stroke="{DynamicResource AccentBrush}" StrokeThickness="3" Opacity="0.85" />
                                                    <Ellipse Canvas.Left="27" Canvas.Top="25" Width="42" Height="42" Fill="#FF0E0F12" Stroke="#44FFFFFF" StrokeThickness="1" />
                                                    <Rectangle Canvas.Left="47" Canvas.Top="29" Width="2" Height="12" RadiusX="1" RadiusY="1" Fill="#DDFFFFFF" />
                                                    <Ellipse Canvas.Left="88" Canvas.Top="18" Width="56" Height="56" Stroke="{DynamicResource AccentBrush}" StrokeThickness="3" Opacity="0.85" />
                                                    <Ellipse Canvas.Left="95" Canvas.Top="25" Width="42" Height="42" Fill="#FF0E0F12" Stroke="#44FFFFFF" StrokeThickness="1" />
                                                    <Rectangle Canvas.Left="115" Canvas.Top="29" Width="2" Height="12" RadiusX="1" RadiusY="1" Fill="#DDFFFFFF" />
                                                    <Ellipse Canvas.Left="156" Canvas.Top="18" Width="56" Height="56" Stroke="{DynamicResource AccentBrush}" StrokeThickness="3" Opacity="0.85" />
                                                    <Ellipse Canvas.Left="163" Canvas.Top="25" Width="42" Height="42" Fill="#FF0E0F12" Stroke="#44FFFFFF" StrokeThickness="1" />
                                                    <Rectangle Canvas.Left="183" Canvas.Top="29" Width="2" Height="12" RadiusX="1" RadiusY="1" Fill="#DDFFFFFF" />
                                                    <Ellipse Canvas.Left="224" Canvas.Top="18" Width="56" Height="56" Stroke="{DynamicResource AccentBrush}" StrokeThickness="3" Opacity="0.85" />
                                                    <Ellipse Canvas.Left="231" Canvas.Top="25" Width="42" Height="42" Fill="#FF0E0F12" Stroke="#44FFFFFF" StrokeThickness="1" />
                                                    <Rectangle Canvas.Left="251" Canvas.Top="29" Width="2" Height="12" RadiusX="1" RadiusY="1" Fill="#DDFFFFFF" />
                                                    <Ellipse Canvas.Left="292" Canvas.Top="18" Width="56" Height="56" Stroke="{DynamicResource AccentBrush}" StrokeThickness="3" Opacity="0.85" />
                                                    <Ellipse Canvas.Left="299" Canvas.Top="25" Width="42" Height="42" Fill="#FF0E0F12" Stroke="#44FFFFFF" StrokeThickness="1" />
                                                    <Rectangle Canvas.Left="319" Canvas.Top="29" Width="2" Height="12" RadiusX="1" RadiusY="1" Fill="#DDFFFFFF" />
                                                    <!-- 5 buttons -->
                                                    <Rectangle Canvas.Left="26" Canvas.Top="98" Width="44" Height="30" RadiusX="7" RadiusY="7" Fill="#FF22252B" Stroke="#40FFFFFF" StrokeThickness="1" />
                                                    <Rectangle Canvas.Left="94" Canvas.Top="98" Width="44" Height="30" RadiusX="7" RadiusY="7" Fill="#FF22252B" Stroke="#40FFFFFF" StrokeThickness="1" />
                                                    <Rectangle Canvas.Left="162" Canvas.Top="98" Width="44" Height="30" RadiusX="7" RadiusY="7" Fill="#FF22252B" Stroke="#40FFFFFF" StrokeThickness="1" />
                                                    <Rectangle Canvas.Left="230" Canvas.Top="98" Width="44" Height="30" RadiusX="7" RadiusY="7" Fill="#FF22252B" Stroke="#40FFFFFF" StrokeThickness="1" />
                                                    <Rectangle Canvas.Left="298" Canvas.Top="98" Width="44" Height="30" RadiusX="7" RadiusY="7" Fill="#FF22252B" Stroke="#40FFFFFF" StrokeThickness="1" />
                                                </Canvas>
                                            </Viewbox>
                                            <Image x:Name="ImgTurnUp" Visibility="Collapsed" Stretch="Uniform" Margin="14"
                                                   RenderOptions.BitmapScalingMode="HighQuality" />
                                        </Grid>
                                    </Border>
                                    <Border x:Name="DrivesPillTurnUp" DockPanel.Dock="Bottom" Margin="18,0,18,18" Style="{StaticResource HwDrivesPill}" MouseLeftButtonUp="DrivesPill_Click"
                                                ToolTip="Show this device's controls in the Mixer, Buttons and Lights tabs">
                                            <StackPanel Orientation="Horizontal">
                                                <mi:MaterialIcon x:Name="DrivesIconTurnUp" Kind="CheckCircle" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                <TextBlock x:Name="DrivesTextTurnUp" Text="Show in Mixer, Buttons &amp; Lights" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                <StackPanel Margin="18,14,18,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Turn Up" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                <TextBlock Text="5 knobs · 5 buttons · 15 RGB LEDs" Style="{StaticResource SSub}" />
                                            </StackPanel>
                                            <Border Grid.Column="1" Style="{StaticResource SPill}" Margin="8,0,0,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse x:Name="ConnectionDot" Style="{StaticResource SDot}" Fill="{DynamicResource DangerRedBrush}" />
                                                    <TextBlock x:Name="TxtConnectionStatus" Text="Disconnected" Style="{StaticResource SStatusText}" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>

                                        <TextBlock Text="Port" Style="{StaticResource SField}" Margin="0,16,0,6"
