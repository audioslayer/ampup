                                        <WrapPanel Orientation="Horizontal">
                                            <ui:Button x:Name="BtnGoveeScan" Content="Scan network" Style="{StaticResource SButton}" />
                                            <ui:Button x:Name="BtnGoveeLanHelp" Style="{StaticResource SButton}" Width="32" Padding="0"
                                                       ToolTip="Not finding devices? Click for help">
                                                <mi:MaterialIcon Kind="HelpCircleOutline" Width="16" Height="16" Foreground="{DynamicResource TextSecBrush}" />
                                            </ui:Button>
                                            <ui:Button x:Name="BtnGoveeRestoreRemoved" Content="Restore removed" Style="{StaticResource SButton}"
                                                       Visibility="Collapsed"
                                                       ToolTip="Allow removed Govee devices to appear on scans again" />
                                            <TextBlock x:Name="TxtGoveeScanStatus" Text="" Style="{StaticResource SStatusText}" Margin="4,0,0,8" />
                                        </WrapPanel>
                                        <StackPanel x:Name="GoveeDeviceList" Margin="0,4,0,0" />
                                    </StackPanel>

                                    <Border Style="{StaticResource SDivider}" />

                                    <!-- Cloud -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                            <TextBlock Text="Cloud API" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <TextBlock Text="Scenes, music mode and devices without LAN support. Needs an API key." Style="{StaticResource SSub}" />
                                        </StackPanel>
                                        <Border Grid.Column="1" Style="{StaticResource SPill}">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse x:Name="GoveeCloudStatusDot" Style="{StaticResource SDot}" />
                                                <TextBlock x:Name="TxtGoveeCloudStatus" Text="Disabled" Style="{StaticResource SStatusText}" />
                                            </StackPanel>
                                        </Border>
                                        <local:SettingsSwitch x:Name="ChkGoveeCloudEnabled" Grid.Column="2" VerticalAlignment="Center" ToolTip="Enable Govee Cloud API" />
                                    </Grid>
                                    <StackPanel x:Name="GoveeCloudSection" Visibility="Collapsed" Margin="0,14,0,0">
                                        <TextBlock Text="API key" Style="{StaticResource SField}" ToolTip="Enables scenes and music mode control" />
                                        <PasswordBox x:Name="TxtGoveeApiKey" Style="{StaticResource SPassword}" Margin="0,0,0,12" />
                                        <WrapPanel Orientation="Horizontal">
                                            <ui:Button x:Name="BtnGoveeSetupGuide" Content="Setup guide" Style="{StaticResource SButton}" />
                                            <TextBlock x:Name="TxtGoveeApiStatus" Text="" Style="{StaticResource SStatusText}" Margin="4,0,0,8" />
                                        </WrapPanel>
                                    </StackPanel>

                                    <TextBlock x:Name="TxtGoveeAmbienceHint" Text="" Style="{StaticResource SHint}" Margin="0,14,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- VoiceMeeter -->
                    <Border x:Name="VoiceMeeterIntegration" Style="{StaticResource SCard}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource SBar}" />
                            <StackPanel Style="{StaticResource SBody}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="VoiceMeeterIconHost" Style="{StaticResource STile}">
                                        <mi:MaterialIcon Kind="TuneVertical" Style="{StaticResource STileIcon}" />
                                    </Border>
                                    <StackPanel Style="{StaticResource SHeaderNames}">
                                        <TextBlock Text="VoiceMeeter" Style="{StaticResource STitle}" />
                                        <TextBlock Text="Adjust strip and bus volume, and toggle mute." Style="{StaticResource SSub}" />
                                    </StackPanel>
                                    <Border Grid.Column="2" Style="{StaticResource SPill}">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse x:Name="VmStatusDotHeader" Style="{StaticResource SDot}" />
                                            <TextBlock x:Name="TxtVmStatusHeader" Text="Disabled" Style="{StaticResource SStatusText}" />
                                        </StackPanel>
                                    </Border>
                                    <local:SettingsSwitch x:Name="ChkVmEnabled" Grid.Column="3" VerticalAlignment="Center" ToolTip="Enable VoiceMeeter" />
                                </Grid>
                                <StackPanel x:Name="VmSettingsPanel" Style="{StaticResource SContent}">
                                    <TextBlock Text="Install folder" Style="{StaticResource SField}" />
                                    <ui:TextBox x:Name="TxtVmInstallFolder" Style="{StaticResource SInput}" IsReadOnly="True" Margin="0,0,0,10"
                                                PlaceholderText="Automatic detection"
                                                ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                                    <WrapPanel Orientation="Horizontal">
                                        <ui:Button x:Name="BtnVmBrowse" Content="Browse" Style="{StaticResource SButton}" />
                                        <ui:Button x:Name="BtnVmAutomatic" Content="Use automatic" Style="{StaticResource SButton}" />
                                    </WrapPanel>
                                    <TextBlock x:Name="TxtVmInstallHint" Text="Amp Up finds VoiceMeeter automatically. Choose its install folder if detection fails."
                                               Style="{StaticResource SHint}" Margin="0" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Corsair iCUE -->
                    <Border x:Name="CorsairIntegration" Style="{StaticResource SCard}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource SBar}" />
                            <StackPanel Style="{StaticResource SBody}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="CorsairIconHost" Style="{StaticResource STile}">
                                        <mi:MaterialIcon Kind="Chip" Style="{StaticResource STileIcon}" />
                                    </Border>
                                    <StackPanel Style="{StaticResource SHeaderNames}">
                                        <TextBlock Text="Corsair iCUE" Style="{StaticResource STitle}" />
                                        <TextBlock Text="Bring Corsair devices into your room lighting setup." Style="{StaticResource SSub}" />
                                    </StackPanel>
                                    <Border Grid.Column="2" Style="{StaticResource SPill}">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse x:Name="CorsairStatusDot" Style="{StaticResource SDot}" />
                                            <TextBlock x:Name="TxtCorsairStatus" Text="Disabled" Style="{StaticResource SStatusText}" />
                                        </StackPanel>
                                    </Border>
                                    <local:SettingsSwitch x:Name="ChkCorsairEnabled" Grid.Column="3" VerticalAlignment="Center" ToolTip="Enable Corsair iCUE" />
                                </Grid>
                                <StackPanel x:Name="CorsairDeviceList" Margin="0,14,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- SignalRGB -->
                    <Border x:Name="SignalRgbIntegration" Style="{StaticResource SCard}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource SBar}" />
                            <StackPanel Style="{StaticResource SBody}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="SignalRgbIconHost" Style="{StaticResource STile}">
                                        <mi:MaterialIcon Kind="PaletteSwatchOutline" Style="{StaticResource STileIcon}" />
                                    </Border>
                                    <StackPanel Style="{StaticResource SHeaderNames}">
                                        <TextBlock Text="SignalRGB" Style="{StaticResource STitle}" />
                                        <TextBlock Text="Sync Turn Up lighting and link effects to your Amp Up profiles." Style="{StaticResource SSub}" />
                                    </StackPanel>
                                    <Border Grid.Column="2" Style="{StaticResource SPill}">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse x:Name="SignalRgbStatusDot" Style="{StaticResource SDot}" />
                                            <TextBlock x:Name="TxtSignalRgbStatus" Text="Disabled" Style="{StaticResource SStatusText}" />
                                        </StackPanel>
                                    </Border>
                                    <local:SettingsSwitch x:Name="ChkSignalRgbEnabled" Grid.Column="3" VerticalAlignment="Center" ToolTip="Enable SignalRGB" />
                                </Grid>
                                <StackPanel x:Name="SignalRgbSettingsPanel" Style="{StaticResource SContent}">
                                    <StackPanel Visibility="Collapsed">
                                        <TextBlock Text="Bridge port" Style="{StaticResource SField}" />
                                        <ui:TextBox x:Name="TxtSignalRgbPort" Style="{StaticResource SInput}" Width="120" HorizontalAlignment="Left" PlaceholderText="45333" />
                                    </StackPanel>
                                    <TextBlock Text="Layout" Style="{StaticResource SField}" />
                                    <controls:ListPicker x:Name="CmbSignalRgbCanvasShape" Width="220" HorizontalAlignment="Left" Margin="0,0,0,12" />
                                    <TextBlock Text="Plugin" Style="{StaticResource SField}" />
                                    <WrapPanel Orientation="Horizontal">
                                        <ui:Button x:Name="BtnSignalRgbInstallPlugin" Content="Update plugin" Style="{StaticResource SButton}" />
                                        <ui:Button x:Name="BtnSignalRgbOpenPluginFolder" Content="Open folder" Style="{StaticResource SButton}" />
                                    </WrapPanel>
                                    <TextBlock x:Name="TxtSignalRgbPluginStatus" Text="" Style="{StaticResource SHint}" Margin="0,0,0,4" />

                                    <TextBlock Text="Ignored lights" Style="{StaticResource SField}" Margin="0,10,0,8" />
                                    <WrapPanel>
                                        <local:SettingsSwitch x:Name="ChkSignalRgbIgnoreKnob1" Text="Light 1" Compact="True" Margin="0,0,20,6" />
                                        <local:SettingsSwitch x:Name="ChkSignalRgbIgnoreKnob2" Text="Light 2" Compact="True" Margin="0,0,20,6" />
                                        <local:SettingsSwitch x:Name="ChkSignalRgbIgnoreKnob3" Text="Light 3" Compact="True" Margin="0,0,20,6" />
                                        <local:SettingsSwitch x:Name="ChkSignalRgbIgnoreKnob4" Text="Light 4" Compact="True" Margin="0,0,20,6" />
                                        <local:SettingsSwitch x:Name="ChkSignalRgbIgnoreKnob5" Text="Light 5" Compact="True" Margin="0,0,0,6" />
                                    </WrapPanel>

                                    <Border Style="{StaticResource SDivider}" />
                                    <local:SettingsSwitch x:Name="ChkSignalRgbProfileSync" Text="Sync Amp Up profiles to SignalRGB"
                                                          Description="Switch SignalRGB effects when you change Amp Up profiles." />
                                    <StackPanel x:Name="SignalRgbProfileSyncPanel" Margin="0,14,0,0">
                                        <TextBlock Text="Profile" Style="{StaticResource SField}" />
                                        <controls:ListPicker x:Name="CmbSignalRgbProfile" Width="220" HorizontalAlignment="Left" Margin="0,0,0,12" />
                                        <TextBlock Text="Effect" Style="{StaticResource SField}" />
                                        <ui:TextBox x:Name="TxtSignalRgbProfileEffect" Style="{StaticResource SInput}" Margin="0,0,0,12"
                                                    PlaceholderText="SignalRGB effect name" />
                                        <TextBlock Text="Layout" Style="{StaticResource SField}" />
                                        <ui:TextBox x:Name="TxtSignalRgbProfileLayout" Style="{StaticResource SInput}" Margin="0,0,0,12"
                                                    PlaceholderText="Optional layout name" />
                                        <WrapPanel Orientation="Horizontal">
                                            <ui:Button x:Name="BtnSignalRgbApplyProfileSync" Content="Apply now" Style="{StaticResource SButton}" />
                                            <TextBlock x:Name="TxtSignalRgbProfileSyncHint" Text="" Style="{StaticResource SStatusText}" Margin="4,0,0,8" />
                                        </WrapPanel>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Discord: status card with Connect / Disconnect, then the tester-preview callout -->
                    <Border x:Name="DiscordIntegration">
                        <StackPanel>
                            <Border Style="{StaticResource SetCard}">
                                <Border Style="{StaticResource SetCardGlass}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border x:Name="DiscordIconHost" Style="{StaticResource STile}">
                                            <mi:MaterialIcon Kind="Headset" Style="{StaticResource STileIcon}" />
                                        </Border>
                                        <StackPanel Style="{StaticResource SHeaderNames}">
                                            <TextBlock Text="Connection" Style="{StaticResource SetCardTitle}" />
                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                <Ellipse x:Name="DiscordStatusDot" Style="{StaticResource SDot}" />
                                                <TextBlock x:Name="TxtDiscordStatus" Text="Unavailable" Style="{StaticResource SStatusText}" FontSize="12" />
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <ui:Button x:Name="BtnDiscordDisconnect" Content="Disconnect" Style="{StaticResource SButton}" IsEnabled="False" Margin="0,0,8,0" />
                                            <ui:Button x:Name="BtnDiscordConnect" Content="Connect" Style="{StaticResource SButton}" Appearance="Primary" Margin="0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Border>
                            <Border Style="{StaticResource SetCard}">
                                <Border Style="{StaticResource SetCardGlass}">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Style="{StaticResource STile}">
                                                <mi:MaterialIcon Kind="InformationOutline" Style="{StaticResource STileIcon}" />
                                            </Border>
                                            <StackPanel Style="{StaticResource SHeaderNames}">
                                                <TextBlock Text="Tester preview" Style="{StaticResource SetCardTitle}" />
                                                <TextBlock Text="Discord only allows approved testers to connect for now." Style="{StaticResource SSub}" />
                                            </StackPanel>
                                        </Grid>
                                        <Border Style="{StaticResource SetRow}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                                    <TextBlock Text="Get tester access" Style="{StaticResource SetRowTitle}" />
                                                    <TextBlock Text="Send a friend request to aud10sayer on Discord asking for Amp Up tester access, then click Connect. The Setup guide walks you through it."
                                                               Style="{StaticResource SSub}" />
                                                </StackPanel>
                                                <ui:Button x:Name="BtnDiscordSetupGuide" Grid.Column="1" Content="Setup guide" Style="{StaticResource SButton}"
                                                           Appearance="Primary" Margin="0" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                        <Border Style="{StaticResource SetRow}" Margin="0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                                    <TextBlock Text="WolfDen community" Style="{StaticResource SetRowTitle}" />
                                                    <TextBlock Text="Get help, share feedback and hear about new builds first." Style="{StaticResource SSub}" />
                                                </StackPanel>
                                                <ui:Button x:Name="BtnDiscordJoinCommunity" Grid.Column="1" Content="Join WolfDen Discord" Style="{StaticResource SButton}"
                                                           Margin="0" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Spotify: status card with Connect / Disconnect, then setup + collapsible Client ID card -->
                    <Border x:Name="SpotifyIntegration">
                        <StackPanel>
                            <Border Style="{StaticResource SetCard}">
                                <Border Style="{StaticResource SetCardGlass}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border x:Name="SpotifyIconHost" Style="{StaticResource STile}">
                                            <mi:MaterialIcon Kind="Spotify" Style="{StaticResource STileIcon}" />
                                        </Border>
                                        <StackPanel Style="{StaticResource SHeaderNames}">
                                            <TextBlock Text="Connection" Style="{StaticResource SetCardTitle}" />
                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                <Ellipse x:Name="SpotifyStatusDot" Style="{StaticResource SDot}" />
                                                <TextBlock x:Name="TxtSpotifyStatus" Text="Not connected" Style="{StaticResource SStatusText}" FontSize="12" />
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <ui:Button x:Name="BtnSpotifyDisconnect" Content="Disconnect" Style="{StaticResource SButton}" IsEnabled="False" Margin="0,0,8,0" />
                                            <ui:Button x:Name="BtnSpotifyConnect" Content="Connect" Style="{StaticResource SButton}" Appearance="Primary" Margin="0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Border>
                            <Border Style="{StaticResource SetCard}">
                                <Border Style="{StaticResource SetCardGlass}">
                                    <StackPanel>
                                        <Border Style="{StaticResource SetRow}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                                    <TextBlock Text="First-time setup" Style="{StaticResource SetRowTitle}" />
                                                    <TextBlock Text="Create a free Spotify app, paste its Client ID, and connect in one go."
                                                               Style="{StaticResource SSub}" />
                                                </StackPanel>
                                                <ui:Button x:Name="BtnSpotifySetupGuide" Grid.Column="1" Content="Setup guide" Style="{StaticResource SButton}"
                                                           Appearance="Primary" Margin="0" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                        <Border Style="{StaticResource SetRow}" Margin="0">
                                            <Expander Foreground="{DynamicResource TextSecBrush}" FontSize="12">
                                                <Expander.Header>
                                                    <StackPanel Margin="4,0,0,0">
                                                        <TextBlock Text="Advanced: Client ID" Style="{StaticResource SetRowTitle}" />
                                                        <TextBlock Text="Already have a Spotify app? Paste its Client ID directly." Style="{StaticResource SSub}" />
                                                    </StackPanel>
                                                </Expander.Header>
                                                <StackPanel Margin="0,12,0,0">
                                                    <TextBlock Text="Client ID" Style="{StaticResource SField}" />
                                                    <ui:TextBox x:Name="TxtSpotifyClientId" Style="{StaticResource SInput}" PlaceholderText="Spotify app Client ID" />
                                                </StackPanel>
                                            </Expander>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </Border>
                        </StackPanel>
                    </Border>
                    </StackPanel>
                </Grid>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
