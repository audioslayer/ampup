                        </StackPanel>
                        <UniformGrid x:Name="DeviceCardGrid" Columns="2" Margin="-6,0,-6,0">

                            <!-- Turn Up -->
                            <Border x:Name="DevCardTurnUp" Style="{StaticResource HwDeviceCard}">
