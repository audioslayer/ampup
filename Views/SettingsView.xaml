                                    <StackPanel>
                                        <Border Style="{StaticResource STile}" HorizontalAlignment="Left" Margin="0,0,0,10">
                                            <mi:MaterialIcon Kind="LinkVariant" Style="{StaticResource STileIcon}" />
                                        </Border>
                                        <TextBlock Text="Both" Style="{StaticResource STitle}" />
                                        <TextBlock Text="Run both controllers at once" Style="{StaticResource SSub}" />
                                    </StackPanel>
                                    <mi:MaterialIcon x:Name="ModeCheckBoth" Kind="CheckCircle" Style="{StaticResource HwModeCheck}" />
                                </Grid>
                            </Border>
