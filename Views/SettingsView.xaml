                                    <mi:MaterialIcon x:Name="ModeCheckAuto" Kind="CheckCircle" Style="{StaticResource HwModeCheck}" />
                                </Grid>
                            </Border>
                            <Border x:Name="ModeCardTurnUp" Tag="1" Style="{StaticResource HwModeCard}" MouseLeftButtonUp="ModeCard_Click">
