.353-.055-.47-.18-.22-.236-.111-.71-.054-.995.052-.26.152-.609.463-.646.484-.057 1.046.148 1.526.22.577.088 1.156.159 1.737.212 2.48.226 5.002.19 7.472-.14.45-.06.899-.13 1.345-.21.399-.072.84-.206 1.08.206.166.281.188.657.162.974a.544.544 0 01-.169.364zm-6.159 3.9c-.862.37-1.84.788-3.109.788a5.884 5.884 0 01-1.569-.217l.877 9.004c.065.78.717 1.38 1.5 1.38 0 0 1.243.065 1.658.065.447 0 1.786-.065 1.786-.065.783 0 1.434-.6 1.499-1.38l.94-9.95a3.996 3.996 0 00-1.322-.238c-.826 0-1.491.284-2.26.613z</Geometry>
        <Style x:Key="SettingsSectionCard" TargetType="Border" BasedOn="{StaticResource CardPanel}">
            <Setter Property="Padding" Value="20" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>
        <Style x:Key="IntegrationHeading" TargetType="TextBlock" BasedOn="{StaticResource HeaderText}">
            <Setter Property="FontSize" Value="17" />
        </Style>
        <Style x:Key="IntegrationDescription" TargetType="TextBlock" BasedOn="{StaticResource SecondaryText}">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource CardPanel}" Margin="20,12,20,10" Padding="8,6">
            <Border BorderBrush="{DynamicResource InputBgBrush}" BorderThickness="0,0,0,1">
                <StackPanel x:Name="SettingsTabRow"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center" />
            </Border>
        </Border>

    <ScrollViewer x:Name="SettingsScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  Background="Transparent">
        <StackPanel Margin="20,0,20,18">

            <!-- ── CONNECTION ──────────────────────────────────────── -->
            <Border x:Name="ConnectionCard" Style="{StaticResource CardPanel}" Margin="0,0,0,8">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Border Width="3" CornerRadius="2" Background="{DynamicResource AccentBrush}" Margin="0,0,10,0" />
                        <TextBlock Text="CONNECTION" Style="{StaticResource HeaderText}" Margin="0" />
                    </StackPanel>

                    <!-- Status indicators -->
                    <StackPanel Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,6">
                            <TextBlock Text="Turn Up"
                                       Width="96"
                                       Style="{StaticResource SecondaryText}"
                                       VerticalAlignment="Center"
                                       Margin="0" />
                            <Ellipse x:Name="ConnectionDot" Width="8" Height="8"
                                     Fill="#FF4444" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="TxtConnectionStatus"
                                       Text="Disconnected"
                                       Style="{StaticResource SecondaryText}"
                                       VerticalAlignment="Center" Margin="0" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="TreasLin N3"
                                       Width="96"
                                       Style="{StaticResource SecondaryText}"
                                       VerticalAlignment="Center"
                                       Margin="0" />
                            <Ellipse x:Name="N3ConnectionDot" Width="8" Height="8"
                                     Fill="#FF4444" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="TxtN3ConnectionStatus"
                                       Text="Not detected"
                                       Style="{StaticResource SecondaryText}"
                                       VerticalAlignment="Center" Margin="0" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Port selector row -->
                    <StackPanel Margin="0,0,0,10">
                        <TextBlock Text="Hardware Mode" Style="{StaticResource SecondaryText}" Margin="0,0,0,6"
                                   ToolTip="Choose whether Amp Up listens to Turn Up, Stream Controller, or both at once" />
                        <controls:SegmentedControl x:Name="SegHardwareMode"
                                                   HorizontalAlignment="Left"
                                                   MinWidth="360"
                                                   Margin="0,0,0,10" />
                        <StackPanel x:Name="ActiveSurfacePanel" Visibility="Collapsed" Margin="0,4,0,10">
                            <TextBlock Text="Active Surface" Style="{StaticResource SecondaryText}" Margin="0,0,0,6"
                                       ToolTip="Which surface drives the Mixer, Buttons, and Lights tabs when both devices are available" />
                            <controls:SegmentedControl x:Name="SegActiveSurface"
                                                       HorizontalAlignment="Left"
                                                       MinWidth="360" />
                        </StackPanel>

                        <StackPanel Margin="0,4,0,10">
                            <TextBlock x:Name="TxtN3IdleSleepLabel" Text="Stream Controller Screen Sleep: 10m"
                                       Style="{StaticResource SecondaryText}" Margin="0,0,0,6"
                                       ToolTip="Blank the N3 LCD screens after this long with no keyboard/mouse activity. Drag to Never to keep them lit." />
                            <StackPanel Orientation="Horizontal">
                                <controls:StyledSlider x:Name="SldN3IdleSleep"
                                                       Minimum="0" Maximum="11"
                                                       Width="360"
                                                       Step="1"
                                                       ShowLabel="False"
                                                       HorizontalAlignment="Left"
                                                       VerticalAlignment="Center" />
                                <ui:Button x:Name="BtnN3SleepNow" Content="Sleep Now"
                                           Appearance="Secondary" Margin="10,0,0,0" Height="34"
                                           VerticalAlignment="Center"
                                           ToolTip="Blank the N3 screens right now. Any keyboard/mouse input wakes them back up." />
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Text="Device Port" Style="{StaticResource SecondaryText}" Margin="0,0,0,6"
                                   ToolTip="Select the COM port for your AmpUp hardware" />
                        <StackPanel Orientation="Horizontal">
                            <controls:ListPicker x:Name="CmbSerialPort" Width="220"
                                      VerticalAlignment="Center"
                                      ToolTip="Available COM ports — select the one for your AmpUp hardware" />
                            <ui:Button x:Name="BtnRefreshPorts" Content="Refresh"
                                       Appearance="Secondary" Margin="8,0,0,0" Height="38"
                                       ToolTip="Rescan for available COM ports" />
                            <ui:Button x:Name="BtnAutoDetect" Content="Auto-Detect"
                                       Appearance="Primary" Margin="8,0,0,0" Height="38"
                                       ToolTip="Automatically find the AmpUp hardware by probing available ports" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Advanced toggle -->
                    <Border BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,1,0,0"
                            Margin="0,4,0,0" Padding="0,10,0,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Cursor="Hand" Margin="0,0,0,0"
                                        x:Name="AdvancedToggle" MouseLeftButtonDown="AdvancedToggle_Click">
                                <TextBlock x:Name="AdvancedArrow" Text="▶" FontSize="9"
                                           Foreground="{StaticResource TextDimBrush}"
                                           VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock Text="Advanced" Style="{StaticResource SecondaryText}"
                                           VerticalAlignment="Center" Margin="0" />
                            </StackPanel>

                            <StackPanel x:Name="AdvancedSection" Visibility="Collapsed" Margin="0,10,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <StackPanel Margin="0,0,24,0">
                                        <TextBlock Text="Serial Port" Style="{StaticResource SecondaryText}" Margin="0,0,0,4"
                                                   ToolTip="COM port for the AmpUp hardware (e.g. COM3)" />
                                        <ui:TextBox x:Name="TxtSerialPort" Width="160"
                                                    PlaceholderText="COM3"
                                                    Background="{DynamicResource InputBgBrush}"
                                                    BorderBrush="{DynamicResource InputBorderBrush}"
                                                    Foreground="{StaticResource TextPrimaryBrush}"
                                                    ToolTip="COM port for the AmpUp hardware (e.g. COM3)" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Baud Rate" Style="{StaticResource SecondaryText}" Margin="0,0,0,4"
                                                   ToolTip="Communication speed — leave at 115200" />
                                        <ui:TextBox x:Name="TxtBaudRate" Width="160"
                                                    PlaceholderText="115200"
                                                    Background="{DynamicResource InputBgBrush}"
                                                    BorderBrush="{DynamicResource InputBorderBrush}"
                                                    Foreground="{StaticResource TextPrimaryBrush}"
                                                    ToolTip="Communication speed — leave at 115200" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </Border>

            <!-- ── STARTUP ─────────────────────────────────────────── -->
            <Border x:Name="GeneralCard" Style="{StaticResource CardPanel}" Margin="0,0,0,8">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Border Width="3" CornerRadius="2" Background="{DynamicResource AccentBrush}" Margin="0,0,10,0" />
                        <TextBlock Text="GENERAL" Style="{StaticResource HeaderText}" Margin="0" />
                    </StackPanel>
                    <CheckBox x:Name="ChkStartWithWindows"
                              Content="Start with Windows"
                              Foreground="{StaticResource TextPrimaryBrush}"
                              VerticalContentAlignment="Center"
                              ToolTip="Launch Amp Up automatically when you log in" />
                    <CheckBox x:Name="ChkAutoSuggestLayout"
                              Content="Auto-suggest knob layout"
                              Foreground="{StaticResource TextPrimaryBrush}"
                              VerticalContentAlignment="Center"
                              Margin="0,6,0,0"
                              ToolTip="Show a banner in Mixer when known apps are detected and knobs are unassigned" />

                </StackPanel>
            </Border>

            <!-- ── APPEARANCE ────────────────────────────────────────── -->
            <Border x:Name="AppearanceCard" Style="{StaticResource CardPanel}" Margin="0,0,0,8">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Border Width="3" CornerRadius="2" Background="{DynamicResource AccentBrush}" Margin="0,0,10,0" />
                        <TextBlock Text="APPEARANCE" Style="{StaticResource HeaderText}" Margin="0" />
                    </StackPanel>
                    <TextBlock Text="Accent Color" Style="{StaticResource SecondaryText}" Margin="0,0,0,8"
                               ToolTip="App-wide theme color — affects headers, LEDs, and highlights" />
                    <WrapPanel x:Name="AccentSwatches" Orientation="Horizontal" />
                    <TextBlock Text="Card Theme" Style="{StaticResource SecondaryText}" Margin="0,12,0,8"
                               ToolTip="Background and card color tint — changes the overall mood of the app" />
                    <WrapPanel x:Name="CardThemeSwatches" Orientation="Horizontal" />
                </StackPanel>
            </Border>

            <!-- ── ABOUT ─────────────────────────────────────────── -->
            <Border x:Name="AboutCard" Style="{StaticResource CardPanel}" Margin="0,0,0,8">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Border Width="3" CornerRadius="2" Background="{DynamicResource AccentBrush}" Margin="0,0,10,0" />
                        <TextBlock Text="VERSION &amp; UPDATES" Style="{StaticResource HeaderText}" Margin="0" />
                    </StackPanel>
                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtVersion" Style="{StaticResource BodyText}" VerticalAlignment="Center" />
                        <ui:Button x:Name="BtnCheckUpdate" Content="Check for Updates"
                                   Appearance="Secondary" Margin="16,0,0,0" />
                    </WrapPanel>
                    <TextBlock x:Name="TxtUpdateStatus" Style="{StaticResource SecondaryText}" Margin="0,8,0,0"
                               Visibility="Collapsed" />
                </StackPanel>
            </Border>

            <!-- ── COMMUNITY & SUPPORT ───────────────────────────────── -->
            <Border x:Name="CommunityCard" Style="{StaticResource CardPanel}" Margin="0,0,0,8">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Border Width="3" CornerRadius="2" Background="{DynamicResource AccentBrush}" Margin="0,0,10,0" />
                        <TextBlock Text="COMMUNITY &amp; SUPPORT" Style="{StaticResource HeaderText}" Margin="0" />
                    </StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="DiscordCommunityTile" CornerRadius="14" MinHeight="168" Cursor="Hand" ClipToBounds="True"
                                ToolTip="discord.gg/TDkfWSjqZ">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#6C77FF" Offset="0" />
                                    <GradientStop Color="#5865F2" Offset="0.45" />
                                    <GradientStop Color="#3A3FB8" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.RenderTransform>
                                <TranslateTransform />
                            </Border.RenderTransform>
                            <Grid>
                                <Path Data="{StaticResource DiscordLogoGeometry}" Fill="White" Opacity="0.16" Stretch="Uniform"
                                      Width="150" Height="116" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-20,-24"
                                      IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
                                    <Path.RenderTransform>
                                        <RotateTransform Angle="-14" />
                                    </Path.RenderTransform>
                                </Path>
                                <Rectangle x:Name="DiscordCommunityTileShine" Width="90" HorizontalAlignment="Left" IsHitTestVisible="False" Opacity="0">
                                    <Rectangle.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#00FFFFFF" Offset="0" />
                                            <GradientStop Color="#40FFFFFF" Offset="0.5" />
                                            <GradientStop Color="#00FFFFFF" Offset="1" />
                                        </LinearGradientBrush>
                                    </Rectangle.Fill>
                                    <Rectangle.RenderTransform>
                                        <TransformGroup>
                                            <SkewTransform AngleX="-20" />
                                            <TranslateTransform X="-120" />
                                        </TransformGroup>
                                    </Rectangle.RenderTransform>
                                </Rectangle>
                                <Border Background="#2EFFFFFF" CornerRadius="10" Padding="9,3" Margin="0,16,16,0"
                                        HorizontalAlignment="Right" VerticalAlignment="Top">
                                    <TextBlock Text="#amp-up" FontSize="11" FontWeight="SemiBold" Foreground="White" />
                                </Border>
                                <StackPanel Margin="20,18,20,18">
                                    <Path Data="{StaticResource DiscordLogoGeometry}" Fill="White" Stretch="Uniform"
                                          Width="34" Height="26" HorizontalAlignment="Left" Margin="0,0,0,12" />
                                    <TextBlock Text="Join the WolfDen" FontSize="17" FontWeight="Bold" Foreground="White" />
                                    <TextBlock Text="Get help, share setups, and request Discord tester access in #amp-up."
                                               FontSize="12" Foreground="#E3E6FF" TextWrapping="Wrap" Margin="0,4,0,14" />
                                    <Border Background="White" CornerRadius="15" Padding="14,7" HorizontalAlignment="Left">
                                        <TextBlock Text="Join Discord  &#x2192;" FontSize="12" FontWeight="Bold" Foreground="#4752C4" />
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border x:Name="CoffeeTile" Grid.Column="2" CornerRadius="14" MinHeight="168" Cursor="Hand" ClipToBounds="True"
                                ToolTip="buymeacoffee.com/audioslayer">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#FFE45C" Offset="0" />
                                    <GradientStop Color="#FFC21A" Offset="0.45" />
                                    <GradientStop Color="#FF7A3D" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.RenderTransform>
                                <TranslateTransform />
                            </Border.RenderTransform>
                            <Grid>
                                <Path Data="{StaticResource CoffeeLogoGeometry}" Fill="#1A1206" Opacity="0.10" Stretch="Uniform"
                                      Height="150" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-6,-30"
                                      IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
                                    <Path.RenderTransform>
                                        <RotateTransform Angle="12" />
                                    </Path.RenderTransform>
                                </Path>
                                <Rectangle x:Name="CoffeeTileShine" Width="90" HorizontalAlignment="Left" IsHitTestVisible="False" Opacity="0">
                                    <Rectangle.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#00FFFFFF" Offset="0" />
                                            <GradientStop Color="#66FFFFFF" Offset="0.5" />
                                            <GradientStop Color="#00FFFFFF" Offset="1" />
                                        </LinearGradientBrush>
                                    </Rectangle.Fill>
                                    <Rectangle.RenderTransform>
                                        <TransformGroup>
                                            <SkewTransform AngleX="-20" />
                                            <TranslateTransform X="-120" />
                                        </TransformGroup>
                                    </Rectangle.RenderTransform>
                                </Rectangle>
                                <Border Background="#261A1206" CornerRadius="10" Padding="9,3" Margin="0,16,16,0"
                                        HorizontalAlignment="Right" VerticalAlignment="Top">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#x2665;" FontSize="11" FontWeight="Bold" Foreground="#E0245E" Margin="0,0,5,0" />
                                        <TextBlock Text="Support" FontSize="11" FontWeight="SemiBold" Foreground="#1A1206" />
                                    </StackPanel>
                                </Border>
                                <StackPanel Margin="20,18,20,18">
                                    <Path Data="{StaticResource CoffeeLogoGeometry}" Fill="#1A1206" Stretch="Uniform"
                                          Width="34" Height="26" HorizontalAlignment="Left" Margin="0,0,0,12" />
                                    <TextBlock Text="Fuel the next update" FontSize="17" FontWeight="Bold" Foreground="#1A1206" />
                                    <TextBlock Text="Amp Up is free and built by one dev. If it made your setup better, a coffee keeps the updates coming."
                                               FontSize="12" Foreground="#4A3510" TextWrapping="Wrap" Margin="0,4,0,14" />
                                    <Border Background="#1A1206" CornerRadius="15" Padding="14,7" HorizontalAlignment="Left">
                                        <TextBlock Text="Buy me a coffee  &#x2192;" FontSize="12" FontWeight="Bold" Foreground="#FFDD00" />
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ── PROFILES ────────────────────────────────────────── -->
            <Border x:Name="ProfilesCard" Style="{StaticResource CardPanel}" Margin="0,0,0,8">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Border Width="3" CornerRadius="2" Background="{DynamicResource AccentBrush}" Margin="0,0,10,0" />
                        <TextBlock Text="PROFILES" Style="{StaticResource HeaderText}" Margin="0" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="Active Profile" Style="{StaticResource SecondaryText}" Margin="0,0,0,4"
                                       ToolTip="The currently loaded profile" />
                            <controls:ListPicker x:Name="CmbProfiles" Width="200"
                                      ToolTip="Select a profile to load or manage" />
                        </StackPanel>
                        <StackPanel VerticalAlignment="Bottom">
                            <StackPanel Orientation="Horizontal">
                                <ui:Button x:Name="BtnSaveProfile" Content="Save"
                                           Appearance="Primary" Margin="0,0,6,0"
                                           ToolTip="Save current settings to this profile" />
                                <ui:Button x:Name="BtnLoadProfile" Content="Load"
                                           Appearance="Secondary" Margin="0,0,6,0"
                                           ToolTip="Load the selected profile" />
                                <ui:Button x:Name="BtnEditProfile" Content="Edit"
                                           Appearance="Secondary" Margin="0,0,6,0"
                                           ToolTip="Edit profile name, icon, and color" />
                                <ui:Button x:Name="BtnNewProfile" Content="New"
                                           Appearance="Secondary" Margin="0,0,6,0"
                                           ToolTip="Create a new profile from current settings" />
                                <ui:Button x:Name="BtnDeleteProfile" Content="Delete"
                                           Appearance="Danger" Margin="0,0,6,0"
                                           ToolTip="Delete the selected profile (cannot be undone)" />
                                <ui:Button x:Name="BtnOverview" Content="Overview"
                                           Appearance="Secondary"
                                           ToolTip="View all knob and button assignments across profiles" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <!-- Export / Import profile files -->
                    <Border BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,1,0,0"
                            Margin="0,10,0,0" Padding="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="Profile files"
                                       Style="{StaticResource SecondaryText}" Margin="0,0,0,8" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal">
                                <ui:Button x:Name="BtnExportProfile" Content="Export Profile"
                                           Appearance="Secondary" Margin="0,0,8,0"
                                           ToolTip="Save the current profile as a .json file" />
                                <ui:Button x:Name="BtnImportProfile" Content="Import Profile"
                                           Appearance="Secondary"
                                           ToolTip="Load a profile from a .json file" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Import from Turn Up -->
                    <Border BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,1,0,0"
                            Margin="0,10,0,0" Padding="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="Turn Up import"
                                       Style="{StaticResource SecondaryText}" Margin="0,0,0,8" TextWrapping="Wrap" />
                            <ui:Button x:Name="BtnImportTurnUp" Content="Import from Turn Up"
                                       Appearance="Secondary" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- BACKUP & RESTORE -->
            <Border x:Name="BackupCard" Style="{StaticResource CardPanel}" Margin="0,0,0,8">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Border Width="3" CornerRadius="2" Background="{DynamicResource AccentBrush}" Margin="0,0,10,0" />
                        <TextBlock Text="BACKUP &amp; RESTORE" Style="{StaticResource HeaderText}" Margin="0" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <ui:Button x:Name="BtnBackupSettings" Content="Backup Settings"
                                   Appearance="Secondary" Margin="0,0,8,0"
                                   ToolTip="Save a full Amp Up settings backup file" />
                        <ui:Button x:Name="BtnRestoreSettings" Content="Restore Settings"
                                   Appearance="Danger"
                                   ToolTip="Restore app settings and profiles from a backup file" />
                    </StackPanel>
                    <TextBlock Text="Backups include tokens/API keys."
                               Style="{StaticResource SecondaryText}" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- LED Calibration moved to the Lights tab (CALIBRATION sub-tab) -->

            <!-- ── INTEGRATIONS ────────────────────────────────────── -->
            <Border x:Name="IntegrationsCard" Margin="0,0,0,8">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Border Width="3" CornerRadius="2" Background="{DynamicResource AccentBrush}" Margin="0,0,10,0" />
                        <TextBlock x:Name="IntegrationHeaderText" Text="INTEGRATIONS" Style="{StaticResource HeaderText}" Margin="0" />
                    </StackPanel>

                    <!-- Home Assistant -->
                    <Border x:Name="HomeAssistantIntegration" Style="{StaticResource SettingsSectionCard}">
                    <StackPanel>
                        <Border BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,16" Margin="0,0,0,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="HomeAssistantIconHost" Width="40" Height="40" CornerRadius="10" Background="{DynamicResource InputBgBrush}" Margin="0,0,12,0" VerticalAlignment="Top">
                                        <controls:PhosphorIcon IconName="House" IconSize="24" IconColor="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Home Assistant" Style="{StaticResource IntegrationHeading}" />
                                        <TextBlock Text="Connect your home controls and entities to AmpUp." Style="{StaticResource IntegrationDescription}" />
                                    </StackPanel>
                                    <Border Grid.Column="2" Background="{DynamicResource InputBgBrush}" CornerRadius="12" Padding="10,5" Margin="16,0,0,0" VerticalAlignment="Top">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse x:Name="HaStatusDotHeader" Width="8" Height="8"
                                            Fill="#555555" VerticalAlignment="Center" Margin="0,0,6,0" />
                                            <TextBlock x:Name="TxtHaStatusHeader" Text="Disabled"
                                            Style="{StaticResource SecondaryText}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>
                        <CheckBox x:Name="ChkHaEnabled"
                                  Content="Enabled"
                                  Foreground="{StaticResource TextPrimaryBrush}"
                                  Margin="0,0,0,8" />
                        <WrapPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="URL" Style="{StaticResource SecondaryText}" Margin="0,0,0,4" />
                                <ui:TextBox x:Name="TxtHaUrl" Width="320"
                                            PlaceholderText="http://homeassistant.local:8123"
                                            Background="{DynamicResource InputBgBrush}"
                                            BorderBrush="{DynamicResource InputBorderBrush}"
                                            Foreground="{StaticResource TextPrimaryBrush}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Token" Style="{StaticResource SecondaryText}" Margin="0,0,0,4" />
                                <PasswordBox x:Name="TxtHaToken" Width="320"
                                             Background="{DynamicResource InputBgBrush}"
                                             BorderBrush="{DynamicResource InputBorderBrush}"
                                             Foreground="{StaticResource TextPrimaryBrush}" />
                            </StackPanel>
                        </WrapPanel>
                        <WrapPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <ui:Button x:Name="BtnHaTest" Content="Test Connection"
                                       Appearance="Secondary" Height="32" />
                            <ui:Button x:Name="BtnHaRefresh" Content="Refresh Entities"
                                       Appearance="Secondary" Height="32" Margin="6,0,0,0" />
                            <Ellipse x:Name="HaStatusDot" Width="8" Height="8"
                                     Fill="#555555" VerticalAlignment="Center" Margin="12,0,6,0" />
                            <TextBlock x:Name="TxtHaStatus" Text=""
                                       Style="{StaticResource SecondaryText}" VerticalAlignment="Center" />
                        </WrapPanel>
                    </StackPanel>
                    </Border>

                    <!-- OBS Studio -->
                    <Border x:Name="ObsIntegration" Style="{StaticResource SettingsSectionCard}">
                        <StackPanel>
                            <Border BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,16" Margin="0,0,0,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="ObsIconHost" Width="40" Height="40" CornerRadius="10" Background="{DynamicResource InputBgBrush}" Margin="0,0,12,0" VerticalAlignment="Top">
                                        <controls:PhosphorIcon IconName="Monitor" IconSize="24" IconColor="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="OBS Studio" Style="{StaticResource IntegrationHeading}" />
                                        <TextBlock Text="Control source audio and switch scenes from your controller." Style="{StaticResource IntegrationDescription}" />
                                    </StackPanel>
                                    <Border Grid.Column="2" Background="{DynamicResource InputBgBrush}" CornerRadius="12" Padding="10,5" Margin="16,0,0,0" VerticalAlignment="Top">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse x:Name="ObsStatusDotHeader" Width="8" Height="8"
                                            Fill="#555555" VerticalAlignment="Center" Margin="0,0,6,0" />
                                            <TextBlock x:Name="TxtObsStatusHeader" Text="Disabled"
                                            Style="{StaticResource SecondaryText}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>
                            <CheckBox x:Name="ChkObsEnabled"
                                      Content="Enabled"
                                      Foreground="{StaticResource TextPrimaryBrush}"
                                      Margin="0,0,0,8" />
                            <WrapPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="Host" Style="{StaticResource SecondaryText}" Margin="0,0,0,4" />
                                    <ui:TextBox x:Name="TxtObsHost" Width="220"
                                                PlaceholderText="localhost"
                                                Background="{DynamicResource InputBgBrush}"
                                                BorderBrush="{DynamicResource InputBorderBrush}"
                                                Foreground="{StaticResource TextPrimaryBrush}" />
                                </StackPanel>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="Port" Style="{StaticResource SecondaryText}" Margin="0,0,0,4" />
                                    <ui:TextBox x:Name="TxtObsPort" Width="100"
                                                PlaceholderText="4455"
                                                Background="{DynamicResource InputBgBrush}"
                                                BorderBrush="{DynamicResource InputBorderBrush}"
                                                Foreground="{StaticResource TextPrimaryBrush}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Password" Style="{StaticResource SecondaryText}" Margin="0,0,0,4" />
                                    <PasswordBox x:Name="TxtObsPassword" Width="220"
                                                 Background="{DynamicResource InputBgBrush}"
                                                 BorderBrush="{DynamicResource InputBorderBrush}"
                                                 Foreground="{StaticResource TextPrimaryBrush}" />
                                </StackPanel>
                            </WrapPanel>
                            <WrapPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <ui:Button x:Name="BtnObsTest" Content="Test Connection"
                                           Appearance="Secondary" Height="32" />
                                <Ellipse x:Name="ObsStatusDot" Width="8" Height="8"
                                         Fill="#555555" VerticalAlignment="Center" Margin="12,0,6,0" />
                                <TextBlock x:Name="TxtObsStatus" Text=""
                                           Style="{StaticResource SecondaryText}" VerticalAlignment="Center" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- Govee -->
                    <Border x:Name="GoveeIntegration" Style="{StaticResource SettingsSectionCard}">
                        <StackPanel>
                            <Border BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,16" Margin="0,0,0,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="GoveeIconHost" Width="40" Height="40" CornerRadius="10" Background="{DynamicResource InputBgBrush}" Margin="0,0,12,0" VerticalAlignment="Top">
                                        <controls:PhosphorIcon IconName="Lightbulb" IconSize="24" IconColor="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Govee" Style="{StaticResource IntegrationHeading}" />
                                        <TextBlock Text="Connect room lighting through LAN sync or the Cloud API." Style="{StaticResource IntegrationDescription}" />
                                    </StackPanel>

                                </Grid>
                            </Border>

                            <!-- Govee connection methods -->
                            <StackPanel>

                                <!-- LAN Column -->
                                <StackPanel>
                                    <TextBlock Text="LAN SYNC" Style="{StaticResource BodyText}" FontWeight="SemiBold" Margin="0,0,0,10" />
                                    <WrapPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <CheckBox x:Name="ChkGoveeEnabled"
                                                  Content="Enable Govee LAN sync"
                                                  Foreground="{StaticResource TextPrimaryBrush}"
                                                  Margin="0,0,16,0" />
                                        <Ellipse x:Name="GoveeStatusDot" Width="8" Height="8"
                                                 Fill="#555555" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBlock x:Name="TxtGoveeStatus" Text="Disabled"
                                                   Style="{StaticResource SecondaryText}" VerticalAlignment="Center" />
                                    </WrapPanel>

                                    <StackPanel x:Name="GoveeLanSection" Visibility="Collapsed">
                                        <WrapPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <ui:Button x:Name="BtnGoveeScan" Content="Scan Network"
                                                       Appearance="Secondary" Height="32" />
                                            <ui:Button x:Name="BtnGoveeLanHelp" Content="?"
                                                       Appearance="Secondary" Width="32" Height="32"
                                                       Margin="6,0,0,0"
                                                       ToolTip="Not finding devices? Click for help" />
                                            <ui:Button x:Name="BtnGoveeRestoreRemoved" Content="Restore Removed"
                                                       Appearance="Secondary" Height="32"
                                                       Margin="6,0,0,0"
                                                       Visibility="Collapsed"
                                                       ToolTip="Allow removed Govee devices to appear on scans again" />
                                            <TextBlock x:Name="TxtGoveeScanStatus" Text=""
                                                       Style="{StaticResource SecondaryText}"
                                                       VerticalAlignment="Center" Margin="10,0,0,0" />
                                        </WrapPanel>
                                        <StackPanel x:Name="GoveeDeviceList" Margin="0,0,0,8" />
                                    </StackPanel>
                                </StackPanel>

                                <Border Height="1" Background="{DynamicResource CardBorderBrush}" Margin="0,16,0,16" />

                                <!-- Cloud API Column -->
                                <StackPanel>
                                    <TextBlock Text="CLOUD API" Style="{StaticResource BodyText}" FontWeight="SemiBold" Margin="0,0,0,10" />
                                    <WrapPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <CheckBox x:Name="ChkGoveeCloudEnabled"
                                                  Content="Enable Govee Cloud API"
                                                  Foreground="{StaticResource TextPrimaryBrush}"
                                                  Margin="0,0,16,0" />
                                        <Ellipse x:Name="GoveeCloudStatusDot" Width="8" Height="8"
                                                 Fill="#555555" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBlock x:Name="TxtGoveeCloudStatus" Text="Disabled"
                                                   Style="{StaticResource SecondaryText}" VerticalAlignment="Center" />
                                    </WrapPanel>

                                    <StackPanel x:Name="GoveeCloudSection" Visibility="Collapsed">
                                        <TextBlock Text="API Key" Style="{StaticResource SecondaryText}" Margin="0,0,0,4"
                                                   ToolTip="Enables scenes and music mode control" />
                                        <WrapPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <PasswordBox x:Name="TxtGoveeApiKey" Width="320"
                                                         Background="{DynamicResource InputBgBrush}"
                                                         BorderBrush="{DynamicResource InputBorderBrush}"
                                                         Foreground="{StaticResource TextPrimaryBrush}" />
                                            <ui:Button x:Name="BtnGoveeSetupGuide" Content="Setup Guide"
                                                       Appearance="Secondary" Margin="8,0,0,0" Height="32" />
                                        </WrapPanel>
                                        <TextBlock x:Name="TxtGoveeApiStatus" Text=""
                                                   Style="{StaticResource SecondaryText}" FontSize="11"
                                                   Margin="0,0,0,0" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>

                            <!-- Hint about Ambience tab -->
                            <TextBlock x:Name="TxtGoveeAmbienceHint" Text=""
                                       Style="{StaticResource SecondaryText}" FontSize="11"
                                       Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- VoiceMeeter -->
                    <Border x:Name="VoiceMeeterIntegration" Style="{StaticResource SettingsSectionCard}">
                        <StackPanel>
                            <Border BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,16" Margin="0,0,0,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="VoiceMeeterIconHost" Width="40" Height="40" CornerRadius="10" Background="{DynamicResource InputBgBrush}" Margin="0,0,12,0" VerticalAlignment="Top">
                                        <controls:PhosphorIcon IconName="SlidersHorizontal" IconSize="24" IconColor="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="VoiceMeeter" Style="{StaticResource IntegrationHeading}" />
                                        <TextBlock Text="Adjust strip and bus volume, and toggle mute." Style="{StaticResource IntegrationDescription}" />
                                    </StackPanel>
                                    <Border Grid.Column="2" Background="{DynamicResource InputBgBrush}" CornerRadius="12" Padding="10,5" Margin="16,0,0,0" VerticalAlignment="Top">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse x:Name="VmStatusDotHeader" Width="8" Height="8"
                                            Fill="#555555" VerticalAlignment="Center" Margin="0,0,6,0" />
                                            <TextBlock x:Name="TxtVmStatusHeader" Text="Disabled"
                                            Style="{StaticResource SecondaryText}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>
                            <CheckBox x:Name="ChkVmEnabled"
                                      Content="Enabled"
                                      Foreground="{StaticResource TextPrimaryBrush}"
                                      Margin="0,0,0,4" />
                            <TextBlock Text="Install folder" Style="{StaticResource SecondaryText}" Margin="0,12,0,6" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:TextBox x:Name="TxtVmInstallFolder" IsReadOnly="True"
                                            PlaceholderText="Automatic detection"
                                            Background="{DynamicResource InputBgBrush}"
                                            BorderBrush="{DynamicResource InputBorderBrush}"
                                            Foreground="{StaticResource TextPrimaryBrush}"
                                            ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                                <ui:Button x:Name="BtnVmBrowse" Grid.Column="1" Content="Browse"
                                           Appearance="Secondary" Margin="8,0,0,0" Height="34" />
                                <ui:Button x:Name="BtnVmAutomatic" Grid.Column="2" Content="Use Automatic"
                                           Appearance="Secondary" Margin="8,0,0,0" Height="34" />
                            </Grid>
                            <TextBlock x:Name="TxtVmInstallHint" Text="AmpUp finds VoiceMeeter automatically. Choose its install folder if detection fails."
                                       Style="{StaticResource SecondaryText}" TextWrapping="Wrap" FontSize="11" Margin="0,8,0,0" />
                            <Expander x:Name="VmSetupGuide" Header="Setup guide" Foreground="{DynamicResource TextSecBrush}" Margin="0,12,0,0">
                                <StackPanel Margin="0,8,0,0">
                                    <TextBlock Text="1. Install and open VoiceMeeter Basic, Banana, or Potato."
                                               Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,0,0,8" />
                                    <TextBlock Text="2. Enable the integration above. AmpUp checks for a connection every five seconds, so either app can start first."
                                               Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,0,0,8" />
                                    <TextBlock Text="3. If the status says Remote API not found, click Browse and select the folder where VoiceMeeter is installed. The usual location is C:\Program Files (x86)\VB\Voicemeeter."
                                               Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,0,0,8" />
                                    <TextBlock Text="4. Once connected, open Mixer to assign a VoiceMeeter strip or bus to a knob. You can also assign mute actions in Buttons."
                                               Style="{StaticResource SecondaryText}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </Border>

                    <!-- Corsair iCUE -->
                    <Border x:Name="CorsairIntegration" Style="{StaticResource SettingsSectionCard}">
                        <StackPanel>
                            <Border BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,16" Margin="0,0,0,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="CorsairIconHost" Width="40" Height="40" CornerRadius="10" Background="{DynamicResource InputBgBrush}" Margin="0,0,12,0" VerticalAlignment="Top">
                                        <controls:PhosphorIcon IconName="Cpu" IconSize="24" IconColor="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Corsair iCUE" Style="{StaticResource IntegrationHeading}" />
                                        <TextBlock Text="Bring Corsair devices into your room lighting setup." Style="{StaticResource IntegrationDescription}" />
                                    </StackPanel>
                                    <Border Grid.Column="2" Background="{DynamicResource InputBgBrush}" CornerRadius="12" Padding="10,5" Margin="16,0,0,0" VerticalAlignment="Top">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse x:Name="CorsairStatusDot" Width="8" Height="8"
                                            Fill="#555555" VerticalAlignment="Center" Margin="0,0,6,0" />
                                            <TextBlock x:Name="TxtCorsairStatus" Text="Disabled"
                                            Style="{StaticResource SecondaryText}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>
                            <CheckBox x:Name="ChkCorsairEnabled"
                                      Content="Enabled"
                                      Foreground="{StaticResource TextPrimaryBrush}"
                                      Margin="0,0,0,4" />
                            <StackPanel x:Name="CorsairDeviceList" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- SignalRGB -->
                    <Border x:Name="SignalRgbIntegration" Style="{StaticResource SettingsSectionCard}">
                        <StackPanel>
                            <Border BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,16" Margin="0,0,0,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="SignalRgbIconHost" Width="40" Height="40" CornerRadius="10" Background="{DynamicResource InputBgBrush}" Margin="0,0,12,0" VerticalAlignment="Top">
                                        <controls:PhosphorIcon IconName="Palette" IconSize="24" IconColor="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="SignalRGB" Style="{StaticResource IntegrationHeading}" />
                                        <TextBlock Text="Sync Turn Up lighting and link effects to your AmpUp profiles." Style="{StaticResource IntegrationDescription}" />
                                    </StackPanel>
                                    <Border Grid.Column="2" Background="{DynamicResource InputBgBrush}" CornerRadius="12" Padding="10,5" Margin="16,0,0,0" VerticalAlignment="Top">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse x:Name="SignalRgbStatusDot" Width="8" Height="8"
                                            Fill="#555555" VerticalAlignment="Center" Margin="0,0,6,0" />
                                            <TextBlock x:Name="TxtSignalRgbStatus" Text="Disabled"
                                            Style="{StaticResource SecondaryText}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>
                            <CheckBox x:Name="ChkSignalRgbEnabled"
                                      Content="Enabled"
                                      Foreground="{StaticResource TextPrimaryBrush}"
                                      Margin="0,0,0,8" />
                            <WrapPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <StackPanel Margin="0,0,12,0" Visibility="Collapsed">
                                    <TextBlock Text="Bridge Port" Style="{StaticResource SecondaryText}" Margin="0,0,0,4" />
                                    <ui:TextBox x:Name="TxtSignalRgbPort" Width="120"
                                                PlaceholderText="45333"
                                                Background="{DynamicResource InputBgBrush}"
                                                BorderBrush="{DynamicResource InputBorderBrush}"
                                                Foreground="{StaticResource TextPrimaryBrush}" />
                                </StackPanel>
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Text="Layout" Style="{StaticResource SecondaryText}" Margin="0,0,0,4" />
                                    <ComboBox x:Name="CmbSignalRgbCanvasShape" Width="160" Height="32"
                                              Background="{DynamicResource InputBgBrush}"
                                              BorderBrush="{DynamicResource InputBorderBrush}"
                                              Foreground="{StaticResource TextPrimaryBrush}">
                                        <ComboBoxItem Content="Classic Strip" />
                                        <ComboBoxItem Content="Knob Grid" />
                                        <ComboBoxItem Content="Arc" />
                                        <ComboBoxItem Content="Matrix" />
                                        <ComboBoxItem Content="Wide Strip" />
                                    </ComboBox>
                                </StackPanel>
                                <WrapPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                                    <ui:Button x:Name="BtnSignalRgbInstallPlugin" Content="Update Plugin"
                                               Appearance="Secondary" Height="32" Margin="0,0,6,0" />
                                    <ui:Button x:Name="BtnSignalRgbOpenPluginFolder" Content="Open Folder"
                                               Appearance="Secondary" Height="32" />
                                </WrapPanel>
                            </WrapPanel>
                            <TextBlock Text="Ignored Lights"
                                       Style="{StaticResource SecondaryText}" Margin="0,8,0,4" />
                            <WrapPanel Margin="0,0,0,4">
                                <CheckBox x:Name="ChkSignalRgbIgnoreKnob1" Content="Light 1"
                                          Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,22,0" />
                                <CheckBox x:Name="ChkSignalRgbIgnoreKnob2" Content="Light 2"
                                          Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,22,0" />
                                <CheckBox x:Name="ChkSignalRgbIgnoreKnob3" Content="Light 3"
                                          Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,22,0" />
                                <CheckBox x:Name="ChkSignalRgbIgnoreKnob4" Content="Light 4"
                                          Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,22,0" />
                                <CheckBox x:Name="ChkSignalRgbIgnoreKnob5" Content="Light 5"
                                          Foreground="{StaticResource TextPrimaryBrush}" />
                            </WrapPanel>
                            <Border BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,1,0,0"
                                    Margin="0,10,0,0" Padding="0,10,0,0">
                                <StackPanel>
                                    <CheckBox x:Name="ChkSignalRgbProfileSync"
                                              Content="Sync AmpUp profiles to SignalRGB"
                                              Foreground="{StaticResource TextPrimaryBrush}"
                                              Margin="0,0,0,8" />
                                    <WrapPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <StackPanel Margin="0,0,12,0">
                                            <TextBlock Text="Profile" Style="{StaticResource SecondaryText}" Margin="0,0,0,4" />
                                            <controls:ListPicker x:Name="CmbSignalRgbProfile" Width="150"
                                                                 Height="32"
                                                                 Background="{DynamicResource InputBgBrush}"
                                                                 BorderBrush="{DynamicResource InputBorderBrush}" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,12,0">
                                            <TextBlock Text="Effect" Style="{StaticResource SecondaryText}" Margin="0,0,0,4" />
                                            <ui:TextBox x:Name="TxtSignalRgbProfileEffect" Width="190"
                                                        PlaceholderText="SignalRGB effect name"
                                                        Background="{DynamicResource InputBgBrush}"
                                                        BorderBrush="{DynamicResource InputBorderBrush}"
                                                        Foreground="{StaticResource TextPrimaryBrush}" />
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="Layout" Style="{StaticResource SecondaryText}" Margin="0,0,0,4" />
                                            <ui:TextBox x:Name="TxtSignalRgbProfileLayout" Width="190"
                                                        PlaceholderText="Optional layout name"
                                                        Background="{DynamicResource InputBgBrush}"
                                                        BorderBrush="{DynamicResource InputBorderBrush}"
                                                        Foreground="{StaticResource TextPrimaryBrush}" />
                                        </StackPanel>
                                    </WrapPanel>
                                    <WrapPanel Orientation="Horizontal">
                                        <ui:Button x:Name="BtnSignalRgbApplyProfileSync" Content="Apply Now"
                                                   Appearance="Secondary" Height="30" Margin="0,0,8,0" />
                                        <TextBlock x:Name="TxtSignalRgbProfileSyncHint" Text=""
                                                   Style="{StaticResource SecondaryText}" FontSize="11"
                                                   VerticalAlignment="Center" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                            <TextBlock x:Name="TxtSignalRgbPluginStatus" Text=""
                                       Style="{StaticResource SecondaryText}" FontSize="11"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Discord -->
                    <Border x:Name="DiscordIntegration" Style="{StaticResource SettingsSectionCard}">
                        <StackPanel>
                            <Border BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,16" Margin="0,0,0,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="DiscordIconHost" Width="40" Height="40" CornerRadius="10" Background="{DynamicResource InputBgBrush}" Margin="0,0,12,0" VerticalAlignment="Top">
                                        <controls:PhosphorIcon IconName="Headphones" IconSize="24" IconColor="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Discord" Style="{StaticResource IntegrationHeading}" />
                                        <TextBlock Text="Discord voice controls and connection availability." Style="{StaticResource IntegrationDescription}" />
                                    </StackPanel>
                                    <Border Grid.Column="2" Background="{DynamicResource InputBgBrush}" CornerRadius="12" Padding="10,5" Margin="16,0,0,0" VerticalAlignment="Top">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse x:Name="DiscordStatusDot" Width="8" Height="8"
                                            Fill="#555555" VerticalAlignment="Center" Margin="0,0,6,0" />
                                            <TextBlock x:Name="TxtDiscordStatus" Text="Unavailable"
                                            Style="{StaticResource SecondaryText}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>
                            <WrapPanel Orientation="Horizontal">
                                <ui:Button x:Name="BtnDiscordConnect" Content="Connect"
                                           Appearance="Secondary" Margin="0,0,8,0" />
                                <ui:Button x:Name="BtnDiscordDisconnect" Content="Disconnect"
                                           Appearance="Secondary" Margin="0,0,8,0" IsEnabled="False" />
                                <ui:Button x:Name="BtnDiscordJoinCommunity" Content="Join WolfDen Discord"
                                           Appearance="Secondary" />
                            </WrapPanel>
                            <TextBlock Style="{StaticResource SecondaryText}" FontSize="11"
                                       TextWrapping="Wrap" Margin="0,8,0,0">
                                <Run Text="Tester preview:" FontWeight="SemiBold" />
                                <Run Text="Discord only allows approved testers to connect for now. To get access, join the WolfDen Discord and DM audio in the #amp-up channel, then click Connect." />
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Spotify -->
                    <Border x:Name="SpotifyIntegration" Style="{StaticResource SettingsSectionCard}">
                        <StackPanel>
                            <Border BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,16" Margin="0,0,0,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="SpotifyIconHost" Width="40" Height="40" CornerRadius="10" Background="{DynamicResource InputBgBrush}" Margin="0,0,12,0" VerticalAlignment="Top">
                                        <controls:PhosphorIcon IconName="MusicNote" IconSize="24" IconColor="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Spotify" Style="{StaticResource IntegrationHeading}" />
                                        <TextBlock Text="Control playback, likes and shuffle, and show LCD album art." Style="{StaticResource IntegrationDescription}" />
                                    </StackPanel>
                                    <Border Grid.Column="2" Background="{DynamicResource InputBgBrush}" CornerRadius="12" Padding="10,5" Margin="16,0,0,0" VerticalAlignment="Top">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse x:Name="SpotifyStatusDot" Width="8" Height="8"
                                            Fill="#555555" VerticalAlignment="Center" Margin="0,0,6,0" />
                                            <TextBlock x:Name="TxtSpotifyStatus" Text="Not connected"
                                            Style="{StaticResource SecondaryText}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>
                            <WrapPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <ui:Button x:Name="BtnSpotifySetupGuide" Content="Setup Guide"
                                           Appearance="Primary" Margin="0,0,8,0" />
                                <ui:Button x:Name="BtnSpotifyConnect" Content="Connect"
                                           Appearance="Secondary" Margin="0,0,8,0" />
                                <ui:Button x:Name="BtnSpotifyDisconnect" Content="Disconnect"
                                           Appearance="Secondary" IsEnabled="False" />
                            </WrapPanel>
                            <Expander Header="Advanced — paste a Client ID directly"
                                      Foreground="{DynamicResource TextDimBrush}"
                                      Margin="0,4,0,0" FontSize="11">
                                <StackPanel Margin="0,8,0,0">
                                    <TextBlock Text="Client ID" Style="{StaticResource SecondaryText}" Margin="0,0,0,4" />
                                    <TextBox x:Name="TxtSpotifyClientId"
                                             Background="{DynamicResource InputBgBrush}"
                                             Foreground="{DynamicResource TextPrimaryBrush}"
                                             BorderBrush="{DynamicResource InputBorderBrush}"
                                             Padding="8,4" />
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </Border>



        </StackPanel>
    </ScrollViewer>

    </Grid>
</UserControl>
