                                    <mi:MaterialIcon x:Name="ModeCheckTurnUp" Kind="CheckCircle" Style="{StaticResource HwModeCheck}" />
                                </Grid>
                            </Border>
                            <Border x:Name="ModeCardStreamController" Tag="2" Style="{StaticResource HwModeCard}" MouseLeftButtonUp="ModeCard_Click">
