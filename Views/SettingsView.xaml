                                        </ui:Button>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <!-- === GENERAL === (hero + glass cards; the outer x:Name Borders are what SelectSettingsTab toggles) -->
                <Border x:Name="GeneralCard">
                    <StackPanel>
                        <Border Style="{StaticResource SetHero}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource SetHeroTile}">
                                    <mi:MaterialIcon Kind="CogOutline" Width="26" Height="26" Foreground="{DynamicResource AccentBrush}" />
