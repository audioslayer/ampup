        <!-- Card: [thin accent bar] [icon tile] [title / subtitle] [actions], body below (matches UiKit.Card) -->
        <Style x:Key="SCard" TargetType="Border" BasedOn="{StaticResource CardPanel}">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style x:Key="SBar" TargetType="Border">
            <Setter Property="Width" Value="3" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Margin" Value="0,14,0,14" />
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        </Style>
        <Style x:Key="SBody" TargetType="StackPanel">
            <Setter Property="Grid.Column" Value="1" />
            <Setter Property="Margin" Value="14,14,16,16" />
        </Style>
        <Style x:Key="STile" TargetType="Border">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="38" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{DynamicResource AccentBg30Brush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBorder55Brush}" />
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="STileIcon" TargetType="mi:MaterialIcon">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="STitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="SSub" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
        <Style x:Key="SHeaderNames" TargetType="StackPanel">
            <Setter Property="Grid.Column" Value="1" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>
        <Style x:Key="SContent" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,16,0,0" />
        </Style>
        <Style x:Key="SField" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecBrush}" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style x:Key="SHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="SStatusText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="SDot" TargetType="Ellipse">
            <Setter Property="Width" Value="7" />
            <Setter Property="Height" Value="7" />
            <Setter Property="Fill" Value="{DynamicResource TextDimBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>
        <Style x:Key="SPill" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource InputBgBrush}" />
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="Padding" Value="9,4" />
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="SDivider" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="{DynamicResource CardBorderBrush}" />
            <Setter Property="Margin" Value="0,16,0,16" />
        </Style>
        <Style x:Key="SGroup" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>
        <Style x:Key="SInput" TargetType="ui:TextBox">
            <Setter Property="Background" Value="{DynamicResource InputBgBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="MaxWidth" Value="440" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
        <Style x:Key="SPassword" TargetType="PasswordBox">
            <Setter Property="Background" Value="{DynamicResource InputBgBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="MaxWidth" Value="440" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="SButton" TargetType="ui:Button">
            <Setter Property="Height" Value="32" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Appearance" Value="Secondary" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ContentControl x:Name="PageHeaderHost" Grid.Row="0" Margin="20,16,20,0" Focusable="False" />

        <!-- Section tabs (underline style) -->
        <Border Grid.Row="1" Margin="20,0,20,14" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1">
            <StackPanel x:Name="SettingsTabRow" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,-1" />
        </Border>

        <ScrollViewer x:Name="SettingsScrollViewer" Grid.Row="2" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" Background="Transparent">
            <StackPanel Margin="20,0,20,18">

                <!-- â•â•â• DEVICES â•â•â• -->
                <Border x:Name="ConnectionCard" Style="{StaticResource SCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource SBar}" />
                        <StackPanel Style="{StaticResource SBody}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource STile}">
                                    <mi:MaterialIcon Kind="UsbPort" Style="{StaticResource STileIcon}" />
                                </Border>
                                <StackPanel Style="{StaticResource SHeaderNames}">
                                    <TextBlock Text="Hardware" Style="{StaticResource STitle}" />
                                    <TextBlock Text="Which controllers Amp Up listens to, and how it connects to them." Style="{StaticResource SSub}" />
                                </StackPanel>
                            </Grid>

                            <StackPanel Style="{StaticResource SContent}">
                                <!-- Device status list -->
                                <Border CornerRadius="8" BorderThickness="1" Padding="12,8" Margin="0,0,0,16"
                                        Background="{DynamicResource BgDarkBrush}" BorderBrush="{DynamicResource CardBorderBrush}">
                                    <StackPanel>
                                        <Grid Margin="0,2,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <mi:MaterialIcon Kind="Knob" Width="16" Height="16" Foreground="{DynamicResource TextDimBrush}" Margin="0,0,10,0" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="Turn Up" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                <Ellipse x:Name="ConnectionDot" Style="{StaticResource SDot}" Fill="{DynamicResource DangerRedBrush}" />
                                                <TextBlock x:Name="TxtConnectionStatus" Text="Disconnected" Style="{StaticResource SStatusText}" />
                                            </StackPanel>
                                        </Grid>
                                        <Grid Margin="0,0,0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <mi:MaterialIcon Kind="ViewGridOutline" Width="16" Height="16" Foreground="{DynamicResource TextDimBrush}" Margin="0,0,10,0" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="Stream Controller (TreasLin N3)" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                <Ellipse x:Name="N3ConnectionDot" Style="{StaticResource SDot}" Fill="{DynamicResource DangerRedBrush}" />
                                                <TextBlock x:Name="TxtN3ConnectionStatus" Text="Not detected" Style="{StaticResource SStatusText}" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <StackPanel Style="{StaticResource SGroup}">
                                    <TextBlock Text="Hardware mode" Style="{StaticResource SField}"
                                               ToolTip="Choose whether Amp Up listens to Turn Up, Stream Controller, or both at once" />
                                    <controls:SegmentedControl x:Name="SegHardwareMode" HorizontalAlignment="Left" MinWidth="360" />
                                </StackPanel>

                                <StackPanel x:Name="ActiveSurfacePanel" Visibility="Collapsed" Style="{StaticResource SGroup}">
                                    <TextBlock Text="Active surface" Style="{StaticResource SField}"
                                               ToolTip="Which surface drives the Mixer, Buttons, and Lights tabs when both devices are available" />
                                    <controls:SegmentedControl x:Name="SegActiveSurface" HorizontalAlignment="Left" MinWidth="360" />
                                </StackPanel>

                                <StackPanel Style="{StaticResource SGroup}">
                                    <TextBlock x:Name="TxtN3IdleSleepLabel" Text="Stream Controller Screen Sleep: 10m" Style="{StaticResource SField}"
                                               ToolTip="Blank the N3 LCD screens after this long with no keyboard/mouse activity. Drag to Never to keep them lit." />
                                    <Grid MaxWidth="520" HorizontalAlignment="Left">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" MinWidth="240" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <controls:StyledSlider x:Name="SldN3IdleSleep" Minimum="0" Maximum="11" Width="360"
                                                               Step="1" ShowLabel="False" VerticalAlignment="Center" />
                                        <ui:Button x:Name="BtnN3SleepNow" Grid.Column="1" Content="Sleep now"
                                                   Appearance="Secondary" Height="32" Margin="12,0,0,0" VerticalAlignment="Center"
                                                   ToolTip="Blank the N3 screens right now. Any keyboard/mouse input wakes them back up." />
                                    </Grid>
                                </StackPanel>

                                <StackPanel>
                                    <TextBlock Text="Turn Up port" Style="{StaticResource SField}"
                                               ToolTip="Select the COM port for your AmpUp hardware" />
                                    <WrapPanel Orientation="Horizontal">
                                        <controls:ListPicker x:Name="CmbSerialPort" Width="220" Margin="0,0,8,8" VerticalAlignment="Center"
                                                             ToolTip="Available COM ports â€” select the one for your AmpUp hardware" />
                                        <ui:Button x:Name="BtnRefreshPorts" Content="Refresh" Style="{StaticResource SButton}"
                                                   ToolTip="Rescan for available COM ports">
                                            <ui:Button.Icon><ui:SymbolIcon Symbol="ArrowClockwise24" /></ui:Button.Icon>
                                        </ui:Button>
                                        <ui:Button x:Name="BtnAutoDetect" Content="Auto-detect" Style="{StaticResource SButton}" Appearance="Primary"
                                                   ToolTip="Automatically find the AmpUp hardware by probing available ports" />
                                    </WrapPanel>
                                </StackPanel>

                                <Border Style="{StaticResource SDivider}" Margin="0,8,0,10" />
                                <StackPanel Orientation="Horizontal" Cursor="Hand" Background="Transparent"
                                            x:Name="AdvancedToggle" MouseLeftButtonDown="AdvancedToggle_Click">
                                    <mi:MaterialIcon x:Name="AdvancedArrow" Kind="ChevronRight" Width="16" Height="16"
                                                     Foreground="{DynamicResource TextDimBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock Text="Advanced serial settings" FontSize="12" Foreground="{DynamicResource TextSecBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel x:Name="AdvancedSection" Visibility="Collapsed" Margin="22,12,0,0">
                                    <TextBlock Text="Serial port" Style="{StaticResource SField}"
                                               ToolTip="COM port for the AmpUp hardware (e.g. COM3)" />
                                    <ui:TextBox x:Name="TxtSerialPort" Style="{StaticResource SInput}" MaxWidth="220" HorizontalAlignment="Left" Width="220"
                                                PlaceholderText="COM3" Margin="0,0,0,12"
                                                ToolTip="COM port for the AmpUp hardware (e.g. COM3)" />
                                    <TextBlock Text="Baud rate" Style="{StaticResource SField}"
                                               ToolTip="Communication speed â€” leave at 115200" />
                                    <ui:TextBox x:Name="TxtBaudRate" Style="{StaticResource SInput}" MaxWidth="220" HorizontalAlignment="Left" Width="220"
                                                PlaceholderText="115200"
                                                ToolTip="Communication speed â€” leave at 115200" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- â•â•â• GENERAL â•â•â• -->
                <Border x:Name="GeneralCard" Style="{StaticResource SCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource SBar}" />
                        <StackPanel Style="{StaticResource SBody}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource STile}">
                                    <mi:MaterialIcon Kind="RocketLaunchOutline" Style="{StaticResource STileIcon}" />
                                </Border>
                                <StackPanel Style="{StaticResource SHeaderNames}">
                                    <TextBlock Text="Startup" Style="{StaticResource STitle}" />
                                    <TextBlock Text="How Amp Up starts and helps you set up." Style="{StaticResource SSub}" />
                                </StackPanel>
                            </Grid>
                            <StackPanel Style="{StaticResource SContent}">
                                <local:SettingsSwitch x:Name="ChkStartWithWindows" Text="Start with Windows"
                                                      Description="Launch Amp Up automatically when you sign in."
                                                      ToolTip="Launch Amp Up automatically when you log in" />
                                <Border Style="{StaticResource SDivider}" Margin="0,12,0,12" />
                                <local:SettingsSwitch x:Name="ChkAutoSuggestLayout" Text="Auto-suggest knob layout"
                                                      Description="Show a banner in Mixer when known apps are detected and knobs are unassigned."
                                                      ToolTip="Show a banner in Mixer when known apps are detected and knobs are unassigned" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border x:Name="AppearanceCard" Style="{StaticResource SCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource SBar}" />
                        <StackPanel Style="{StaticResource SBody}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource STile}">
                                    <mi:MaterialIcon Kind="PaletteOutline" Style="{StaticResource STileIcon}" />
                                </Border>
                                <StackPanel Style="{StaticResource SHeaderNames}">
                                    <TextBlock Text="Appearance" Style="{StaticResource STitle}" />
                                    <TextBlock Text="Accent colour and background theme for the whole app." Style="{StaticResource SSub}" />
                                </StackPanel>
                            </Grid>
                            <StackPanel Style="{StaticResource SContent}">
                                <TextBlock Text="Accent colour" Style="{StaticResource SField}" Margin="0,0,0,8"
                                           ToolTip="App-wide theme color â€” affects headers, LEDs, and highlights" />
                                <WrapPanel x:Name="AccentSwatches" Orientation="Horizontal" />
                                <TextBlock Text="Card theme" Style="{StaticResource SField}" Margin="0,16,0,8"
                                           ToolTip="Background and card color tint â€” changes the overall mood of the app" />
                                <WrapPanel x:Name="CardThemeSwatches" Orientation="Horizontal" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border x:Name="AboutCard" Style="{StaticResource SCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource SBar}" />
                        <StackPanel Style="{StaticResource SBody}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource STile}">
                                    <mi:MaterialIcon Kind="Update" Style="{StaticResource STileIcon}" />
                                </Border>
                                <StackPanel Style="{StaticResource SHeaderNames}">
                                    <TextBlock Text="Version &amp; updates" Style="{StaticResource STitle}" />
                                    <TextBlock x:Name="TxtVersion" Style="{StaticResource SSub}" />
                                </StackPanel>
                                <ui:Button x:Name="BtnCheckUpdate" Grid.Column="2" Content="Check for updates"
                                           Appearance="Secondary" Height="32" VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock x:Name="TxtUpdateStatus" Style="{StaticResource SHint}" FontSize="12" Margin="50,12,0,0"
                                       Visibility="Collapsed" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border x:Name="CommunityCard" Style="{StaticResource SCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource SBar}" />
                        <StackPanel Style="{StaticResource SBody}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource STile}">
                                    <mi:MaterialIcon Kind="HeartOutline" Style="{StaticResource STileIcon}" />
                                </Border>
                                <StackPanel Style="{StaticResource SHeaderNames}">
                                    <TextBlock Text="Community &amp; support" Style="{StaticResource STitle}" />
                                    <TextBlock Text="Get help, share setups and support development." Style="{StaticResource SSub}" />
                                </StackPanel>
                            </Grid>
                            <StackPanel Style="{StaticResource SContent}">
                                <Border x:Name="DiscordCommunityTile" CornerRadius="12" MinHeight="132" Cursor="Hand" ClipToBounds="True"
                                        Margin="0,0,0,12" ToolTip="discord.gg/TDkfWSjqZ">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#6C77FF" Offset="0" />
