                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border x:Name="AppearanceCard">
                    <StackPanel>
                        <Border Style="{StaticResource SetCard}">
                            <Border Style="{StaticResource SetCardGlass}">
                                <StackPanel>
                                <Grid Margin="0,0,0,18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource STile}">
                                        <mi:MaterialIcon Kind="PaletteOutline" Style="{StaticResource STileIcon}" />
                                    </Border>
                                    <StackPanel Style="{StaticResource SHeaderNames}">
                                        <TextBlock Text="Appearance" Style="{StaticResource SetCardTitle}" />
                                        <TextBlock Text="Accent colour and background theme for the whole app." Style="{StaticResource SSub}" />
                                    </StackPanel>
                                </Grid>
                                <Border Style="{StaticResource SetRow}">
                                    <StackPanel>
                                        <TextBlock Text="Accent colour" Style="{StaticResource SetRowTitle}"
                                                   ToolTip="App-wide theme color: affects headers, LEDs, and highlights" />
                                        <TextBlock Text="Headers, LEDs and highlights across the app." Style="{StaticResource SSub}" Margin="0,2,0,12" />
                                        <WrapPanel x:Name="AccentSwatches" Orientation="Horizontal" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource SetRow}">
                                    <StackPanel>
                                        <TextBlock Text="Card theme" Style="{StaticResource SetRowTitle}"
                                                   ToolTip="Background and card color tint: changes the overall mood of the app" />
                                        <TextBlock Text="Background and card tint; sets the overall mood." Style="{StaticResource SSub}" Margin="0,2,0,12" />
                                        <WrapPanel x:Name="CardThemeSwatches" Orientation="Horizontal" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource SetRow}" Margin="0">
                                    <local:SettingsSwitch x:Name="ChkReduceEffects" Text="Reduce effects"
                                                          Description="Turns off glows and shadows for a lighter, faster interface."
                                                          ToolTip="Turns off glows and shadows for a lighter, faster interface" />
                                </Border>
                                </StackPanel>
                            </Border>
                        </Border>
                    </StackPanel>
                </Border>

                <Border x:Name="AboutCard">
                    <StackPanel>
                        <Border Style="{StaticResource SetCard}">
                            <Border Style="{StaticResource SetCardGlass}">
                                <StackPanel>
                                <Grid Margin="0,0,0,18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource STile}">
                                        <mi:MaterialIcon Kind="InformationOutline" Style="{StaticResource STileIcon}" />
                                    </Border>
