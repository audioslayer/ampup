                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource STile}" Width="52" Height="52" CornerRadius="14">
                                    <mi:MaterialIcon Kind="UsbPort" Width="26" Height="26" Foreground="{DynamicResource AccentBrush}" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0,12,0">
                                    <TextBlock Text="Your devices" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock x:Name="TxtHwSummary" Text="Mode: Auto" Style="{StaticResource SSub}" FontSize="12" />
                                </StackPanel>
                                <Border Grid.Column="2" Style="{StaticResource SPill}" Margin="0" Padding="12,6">
