<UserControl x:Class="AmpUp.Views.OsdView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Layout is built in code-behind (BuildUi) so it can share the
         section-card / switch / pill helpers used by the Room tab. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  Background="Transparent">
        <StackPanel x:Name="RootPanel" Margin="24,16,24,24" />
    </ScrollViewer>
</UserControl>
