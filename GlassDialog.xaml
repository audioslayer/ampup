<Window x:Class="AmpUp.GlassDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        Background="{DynamicResource BgDarkBrush}"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="Height"
        Width="420">
    <!-- Same chrome as Controls/TextEditDialog: no AllowsTransparency (layered windows break hit-testing on Win11) -->

    <Window.Resources>
        <Storyboard x:Key="FadeIn">
            <DoubleAnimation Storyboard.TargetName="RootPanel"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.15">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Window.Resources>

    <Border x:Name="RootPanel" Opacity="0"
            CornerRadius="12" BorderThickness="1"
            Background="{DynamicResource BgDarkBrush}"
            BorderBrush="{DynamicResource CardBorderBrush}">
        <StackPanel Margin="20,16,20,18">
            <!-- Header: icon tile + title, close on the right (drag to move) -->
            <Grid x:Name="HeaderGrid" Background="Transparent" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ContentControl x:Name="IconHost" Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center" />
                <TextBlock x:Name="TitleText" Grid.Column="1"
                           FontSize="15" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" />
                <ContentControl x:Name="CloseHost" Grid.Column="2" VerticalAlignment="Top" />
            </Grid>

            <!-- Message -->
            <TextBlock x:Name="MessageText"
                       FontSize="13"
                       Foreground="{DynamicResource TextSecBrush}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,16" />

            <!-- Custom content area (hidden by default) -->
            <StackPanel x:Name="ContentArea" Margin="0,0,0,16" />

            <!-- Input (hidden by default, shown for Prompt dialogs) -->
            <Border x:Name="InputBorder" Visibility="Collapsed"
                    Background="{DynamicResource InputBgBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1" CornerRadius="10" Padding="4,2"
                    MinHeight="44"
                    Margin="0,0,0,16">
                <TextBox x:Name="InputBox"
                         FontSize="14"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         Background="Transparent"
                         BorderThickness="0"
                         VerticalContentAlignment="Center"
                         Padding="8,6" />
            </Border>

            <!-- Buttons -->
            <StackPanel x:Name="ButtonPanel" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                <!-- Buttons added in code-behind -->
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
