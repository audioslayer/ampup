<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <SupportedOSPlatformVersion>7.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>AmpUp</AssemblyName>
    <RootNamespace>AmpUp</RootNamespace>
    <ApplicationManifest>Assets\app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\ampup.ico</ApplicationIcon>
    <Version>1.3.2</Version>
    <AssemblyVersion>1.3.2.0</AssemblyVersion>
    <FileVersion>1.3.2.0</FileVersion>
    <GenerateAssemblyInfo Condition="'$(MSBuildProjectName)' != 'AmpUp'">false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <!-- Trimming flags are passed via build-installer.bat, not here -->
    <!-- WPF doesn't support PublishTrimmed in the project file -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\knob-face.png" />
    <Resource Include="Assets\icon\ampup-16.png" />
    <Resource Include="Assets\icon\ampup-24.png" />
    <Resource Include="Assets\icon\ampup-32.png" />
    <Resource Include="Assets\icon\ampup-48.png" />
    <Resource Include="Assets\icon\ampup-64.png" />
    <Resource Include="Assets\icon\ampup-128.png" />
    <Resource Include="Assets\icon\ampup-256.png" />
    <Resource Include="Assets\icon\ampup-512.png" />
    <Resource Include="Fonts\MaterialSymbolsOutlined.ttf" />
    <Resource Include="Fonts\SpaceGrotesk-VariableFont_wght.ttf" />
    <Resource Include="Fonts\DMSans-Variable.ttf" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="AmpUp.Mac\**\*.cs" />
    <None Remove="AmpUp.Mac\**" />
    <Page Remove="AmpUp.Mac\**\*.xaml" />
    <Resource Remove="AmpUp.Mac\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="AmpUp.Core\AmpUp.Core.csproj" />
  </ItemGroup>

  <!-- Exclude sibling project subdirectories from this project's compilation -->
  <ItemGroup>
    <Compile Remove="AmpUp.Core\**" />
    <None Remove="AmpUp.Core\**" />
    <Content Remove="AmpUp.Core\**" />
    <EmbeddedResource Remove="AmpUp.Core\**" />
    <Compile Remove="Tools\**" />
    <None Remove="Tools\**" />
    <Content Remove="Tools\**" />
    <EmbeddedResource Remove="Tools\**" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Icons\*.jpg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="Icons\*.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="Icons\*.gif">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <None Include="x64\iCUESDK.x64_2019.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>x64\iCUESDK.x64_2019.dll</Link>
    </None>
  </ItemGroup>

  <ItemGroup>
    <None Include="integrations\signalrgb\AmpUp_TurnUp_Bridge.js">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WindowsForms" />
    <PackageReference Include="Hwinfo.SharedMemory.Net" Version="2.1.0" />
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.7-pre700" />
    <PackageReference Include="Svg.Skia" Version="4.3.0" />
    <PackageReference Include="WPF-UI" Version="4.*" />
    <PackageReference Include="Material.Icons.WPF" Version="3.*" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="System.IO.Ports" Version="10.0.8" />
    <PackageReference Include="SpotifyAPI.Web" Version="7.*" />
    <PackageReference Include="SpotifyAPI.Web.Auth" Version="7.*" />
  </ItemGroup>

</Project>
