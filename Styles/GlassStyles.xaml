<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    mc:Ignorable="po">

    <!-- Shared glass look (see Controls/GLASS_STYLE.md). Named styles only, nothing implicit.
         Cheap to draw: frozen brushes, no effects, no blur. The Glass*Brush defaults below are
         replaced at runtime by Controls/GlassStyle.Init() with versions baked over the current
         card theme / accent (and flat ones when Reduce effects is on), so always use them via
         DynamicResource. -->

    <!-- ── Default brushes (Midnight theme, green accent) ────────────── -->
    <LinearGradientBrush x:Key="GlassCardFillBrush" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Color="#2C2C2C" Offset="0" />
        <GradientStop Color="#202020" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GlassCardBorderBrush" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Color="#34FFFFFF" Offset="0" />
        <GradientStop Color="#0CFFFFFF" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GlassCardBorderAccentBrush" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Color="#6600E676" Offset="0" />
        <GradientStop Color="#1800E676" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="GlassPillFillBrush" Color="#2800E676" po:Freeze="True" />
    <SolidColorBrush x:Key="GlassPillBorderBrush" Color="#9600E676" po:Freeze="True" />

    <!-- ── Cards ─────────────────────────────────────────────────── -->
    <Style x:Key="GlassCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource GlassCardFillBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource GlassCardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="GlassCardAccent" TargetType="Border" BasedOn="{StaticResource GlassCard}">
        <Setter Property="BorderBrush" Value="{DynamicResource GlassCardBorderAccentBrush}" />
    </Style>

    <!-- ── Pill (chip / badge / active tab) ──────────────────────── -->
    <Style x:Key="GlassPill" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource GlassPillFillBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource GlassPillBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="Padding" Value="12,4" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- ── Primary button (plain WPF Button; WPF-UI buttons keep their own templates) ── -->
    <Style x:Key="GlassPrimaryButton" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Foreground" Value="#0F0F0F" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentGlowBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Padding" Value="16,7" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" CornerRadius="9" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentGlowBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentDimBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource TextPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Text / rows ───────────────────────────────────────────── -->
    <Style x:Key="GlassSectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Margin" Value="0,4,0,10" />
    </Style>

    <Style x:Key="GlassSettingRow" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource GlassCardFillBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource GlassCardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="14,12" />
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

</ResourceDictionary>
